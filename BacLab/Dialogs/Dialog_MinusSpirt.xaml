                                <TextBox Grid.Row="23" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                     Text="{Binding Water_xol_search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="дослідження"/>

                                <TextBlock Text="Грунт" Grid.Row="24" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
