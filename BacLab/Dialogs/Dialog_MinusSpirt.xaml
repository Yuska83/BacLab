                                 materialDesign:HintAssist.Hint="кіл-ть" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                 Text="{Binding SpirtMazky, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:0.000}}"
                                 materialDesign:HintAssist.Hint="л"/>

                                <TextBlock Text="Обробка кранів перед забором води" Grid.Row="4" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="5" Grid.Column="0" Margin="5" 
                                 Text="{Binding Krany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="кіл-ть"/>
                                <TextBox Grid.Row="5" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                 Text="{Binding SpirtKrany, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:0.000}}"
                                 materialDesign:HintAssist.Hint="л"/>

                                <TextBlock Text="Обробка фільтрувально апарату" Grid.Row="6" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="7" Grid.Column="0" Margin="5" 
                                 Text="{Binding FiltrApparat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="кіл-ть проб води"/>
                                <TextBox Grid.Row="7" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                 Text="{Binding SpirtFiltrApparat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:0.000}}"
                                 materialDesign:HintAssist.Hint="л"/>


                                <TextBlock Text="Задачі" Grid.Row="8" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="9" Grid.Column="0" Margin="5" 
                                 Text="{Binding Zadachi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="кіл-ть"/>
                                <TextBox Grid.Row="9" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                 Text="{Binding SpirtZadachi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:0.000}}"
                                 materialDesign:HintAssist.Hint="л"/>

                                <TextBlock Text="Обробка рук, столів" Grid.Row="10" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="11" Grid.Column="0" Margin="5" 
                                 x:Name="x_SpirtObrobkaHandTable"
                                 materialDesign:HintAssist.Hint="л"
                                 PreviewTextInput ="TextBox_PreviewTextInput" 
                                 TextChanged="Spirt_TextChanged"/>


                                <TextBlock Text="Обробка термостатів, холодильників, ШББ" Grid.Row="12" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="13" Grid.Column="0" Margin="5" 
                                 x:Name="x_SpirtObrobkaTermostat"
                                 PreviewTextInput ="TextBox_PreviewTextInput" 
                                 TextChanged="Spirt_TextChanged"
                                 materialDesign:HintAssist.Hint="л"/>

                                <TextBlock Text="Приготування реактивів" Grid.Row="14" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="15" Grid.Column="0" Margin="5" 
                                     x:Name="x_SpirtPrygotuvannyReactyviv"
                                     PreviewTextInput ="TextBox_PreviewTextInput" 
                                     TextChanged="Spirt_TextChanged"
                                     materialDesign:HintAssist.Hint="л"/>

                                <TextBlock Text="Розхід ентомолога" Grid.Row="16" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="17" Grid.Column="0" Margin="5" 
                                     x:Name="x_SpirtEntomolog"
                                     PreviewTextInput ="TextBox_PreviewTextInput" 
                                     TextChanged="Spirt_TextChanged" 
                                     materialDesign:HintAssist.Hint="л"/>
                                <TextBlock Text="Внутришнє переміщення" Grid.Row="18" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="19" Grid.Column="0" Margin="5" 
                                     x:Name="x_SpirtVnutryshnePeremishenya"
                                     PreviewTextInput ="TextBox_PreviewTextInput" 
                                     TextChanged="Spirt_TextChanged" 
                                     materialDesign:HintAssist.Hint="л"/>

                                <TextBlock Text="Інші витрати" Grid.Row="20" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="21" Grid.Column="0" Margin="5" 
                                     x:Name="x_SpirtOther"
                                     PreviewTextInput ="TextBox_PreviewTextInput" 
                                     TextChanged="Spirt_TextChanged" 
                                     materialDesign:HintAssist.Hint="л"/>
                                <TextBox Grid.Row="22" Grid.Column="0" Margin="10 5 5 5"  Grid.ColumnSpan="2" 
                                     x:Name="x_SpirtOtherComment" HorizontalAlignment="Left"
                                     TextChanged="Spirt_TextChanged" Width="200"
                                     materialDesign:HintAssist.Hint="пояснення"/>


                                <TextBlock Text="ВСЬОГО" Grid.Row="23" Grid.Column="0" Margin="5" Grid.ColumnSpan="2" FontWeight="Bold"/>
                                <TextBox Grid.Row="24" Grid.Column="0" Margin="5"  IsReadOnly="True" FontWeight="Bold"
                                 Text="{Binding SpirtSumOther, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.000}}"
                                 materialDesign:HintAssist.Hint="л"/>

                                <TextBlock Text="СПИРТ ВСЬОГО" Grid.Row="23" Grid.Column="1" Margin="5" Grid.ColumnSpan="2" FontWeight="Bold"/>
                                <TextBox Grid.Row="24" Grid.Column="1" Margin="5"  IsReadOnly="True"  FontWeight="Bold"  FontSize="16"  
                                     Text="{Binding SpirtVsyogo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.000}}"
                                     materialDesign:HintAssist.Hint="л">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"  Value="True">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Setter Property="ToolTip" Value=""/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEnabled,Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"  Value="False">
                                                    <Setter Property="Foreground" Value="Red" />
                                                    <Setter Property="ToolTip" Value="Перевищує залишок"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="{Binding ZalyshokStr}" Grid.Row="25" Grid.Column="1" Margin="5" 
                                           Grid.ColumnSpan="2" FontWeight="Bold"
                                           Foreground="Red"
                                           Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityBackConvector}}"/>
                            </Grid>
                        </ScrollViewer>
                    </materialDesign:Card>
                </Grid>
            </materialDesign:Card>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" DataContext="{Binding SelectedSpirt}">
                <Button x:Name="saveBTN" Click="saveBTN_Click" IsDefault="True" IsEnabled="{Binding IsEnabled}"
                    >Зберегти
                </Button>
                <Button x:Name="cancelBTN" Click="cancelBTN_Click"  Margin="8 0 0 0" 
                    Command="{x:Static wpf:DialogHost.CloseDialogCommand}">
                    Відмінити
                </Button>
            </StackPanel>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>