                                <TextBox Grid.Row="21" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                 Text="{Binding Water_stichna_search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="дослідження"/>

