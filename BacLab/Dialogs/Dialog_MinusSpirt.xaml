                                 materialDesign:HintAssist.Hint="дослідження"/>

                                <TextBlock Text="Вода питна" Grid.Row="10" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="11" Grid.Column="0" Margin="5" 
