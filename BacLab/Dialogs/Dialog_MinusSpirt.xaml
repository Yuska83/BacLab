<UserControl x:Class="BacLab.Dialogs.Dialog_MinusSpirt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" Height="Auto" Width="Auto"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:Dialogs="clr-namespace:BacLab.Dialogs"
             d:DataContext="{d:DesignInstance Dialogs:Dialog_MinusSpirt,IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Models:BoolToVisibilityBackConvector x:Key="BoolToVisibilityBackConvector"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.MaterialDesignTextBox}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="100"/>
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>
    <materialDesign:DialogHost Identifier="MsgDialogSpirt" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>-->
            <TextBlock Text="Списання спирту" FontWeight="Bold" FontSize="20" Grid.Row="0"
                   TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center" />

            <TextBlock x:Name="x_name" FontWeight="Bold" FontSize="20" Grid.Row="1"
                   TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <DatePicker x:Name="x_date" Grid.Row="1" Margin="40 0 0 0" Width="120" 
                    SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center" HorizontalAlignment="Left" 
                    SelectedDateChanged="x_date_SelectedDateChanged"/>

            <materialDesign:Card Grid.Row="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                            <Grid Margin="5" DataContext="{Binding SelectedSpirt}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Клінічний матеріал" Grid.Row="1" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="2" Grid.Column="0" Margin="5"  IsReadOnly="True"
                                     Text="{Binding Klin_analis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="аналізи"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                     Text="{Binding Klin_search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="дослідження"/>

                                <TextBlock Text="Кишкова група" Grid.Row="3" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="4" Grid.Column="0" Margin="5"  IsReadOnly="True"
                                     Text="{Binding Kysh_analis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="аналізи"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                     Text="{Binding Kysh_search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="дослідження"/>

                                <TextBlock Text="Профілактичні дослідження" Grid.Row="5" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="6" Grid.Column="0" Margin="5"  IsReadOnly="True"
                                     Text="{Binding Prof_analis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="аналізи"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                     Text="{Binding Prof_search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="дослідження"/>
                                <TextBlock Text="Крапельна група" Grid.Row="7" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="8" Grid.Column="0" Margin="5"   IsReadOnly="True"
                                     Text="{Binding Kap_analis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="аналізи"/>
                                <TextBox Grid.Row="8" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                     Text="{Binding Kap_search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="дослідження"/>
                                <TextBlock Text="ВСЬОГО" Grid.Row="9" Grid.Column="0" Margin="5" Grid.ColumnSpan="2" FontWeight="Bold"/>
                                <TextBox Grid.Row="10" Grid.Column="0" Margin="5"  IsReadOnly="True" FontWeight="Bold"
                                 Text="{Binding VsyogoSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="досліджень"/>
                                <TextBox Grid.Row="10" Grid.Column="1" Margin="5"  IsReadOnly="True" FontWeight="Bold"
                                 Text="{Binding SpirtSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.000}}"
                                 materialDesign:HintAssist.Hint="л"/>
                            </Grid>
                        </ScrollViewer>
                    </materialDesign:Card>


                    <materialDesign:Card Grid.Column="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="5" DataContext="{Binding SelectedSpirt}">
                                <Grid.RowDefinitions>
