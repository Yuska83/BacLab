                                <TextBlock Text="Вода пов.водоймищ" Grid.Row="14" Grid.Column="0" Margin="5" Grid.ColumnSpan="2"/>
                                <TextBox Grid.Row="15" Grid.Column="0" Margin="5" 
                                 Text="{Binding WaterRiver_analis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="аналізи"/>
                                <TextBox Grid.Row="15" Grid.Column="1" Margin="5"  IsReadOnly="True"
                                 Text="{Binding WaterRiver_search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="дослідження"/>
                                
