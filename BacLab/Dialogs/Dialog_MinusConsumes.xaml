<UserControl x:Class="BacLab.Dialogs.Dialog_MinusConsumes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
xmlns:Dialog="clr-namespace:BacLab.Dialogs"
xmlns:Models="clr-namespace:BacLab.Models"
mc:Ignorable="d" Background="White"
d:DataContext="{d:DesignInstance Dialog:Dialog_MinusConsumes,IsDesignTimeCreatable=False}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Списати" Margin="5"  HorizontalAlignment="Center" FontWeight="Bold" FontSize="12"/>
        <TextBlock Grid.Row="1" x:Name="x_name" Margin="5" HorizontalAlignment="Stretch"  FontWeight="Bold" FontSize="16"/>
        <TextBlock Grid.Row="2" x:Name="x_alarm" Margin="5" HorizontalAlignment="Stretch"  FontWeight="Bold" FontSize="16" Foreground="Red" TextAlignment="Center" >
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DatePicker Grid.Row="3" x:Name="x_date" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Stretch" FontSize="16"/>
        <TextBox  Grid.Row="4" Grid.Column="1"  x:Name="x_quantity" VerticalAlignment="Center" FontSize="16"
                  materialDesign:HintAssist.Hint="{Binding Units, Mode=OneWay }"
                  Margin="5" TextAlignment="Left"/>
        <StackPanel Grid.Row="5"  Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button x:Name="saveBTN" Click="saveBTN_Click" IsDefault="True"
                    >Зберегти
            </Button>
            <Button x:Name="cancelBTN" Click="cancelBTN_Click"  Margin="8 0 0 0" 
                    Command="{x:Static wpf:DialogHost.CloseDialogCommand}">
                Відмінити
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
