<UserControl x:Class="BacLab.Dialogs.Dialog_AddMedium"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d" Height="Auto" Width="Auto"
             xmlns:Dialogs="clr-namespace:BacLab.Dialogs"
             d:DataContext="{d:DesignInstance Dialogs:Dialog_AddMedium,IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignComboBoxEditableTextBox}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <ControlTemplate x:Key="itemListBox" >
            <TextBlock Text="{Binding name}" />
        </ControlTemplate>
        <DataTemplate x:Key="itemsListBox">
            <Control Template="{StaticResource itemListBox}" />
        </DataTemplate>
        
        <ControlTemplate x:Key="itemComboBox" >
            <TextBlock Text="{Binding name}"/>
        </ControlTemplate>
        <DataTemplate x:Key="itemsComboBox">
            <Control Template="{StaticResource itemComboBox}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="x_name"  FontWeight="Bold" FontSize="20" Grid.ColumnSpan="5"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0"/>
        <materialDesign:Card Grid.Row="1">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Всі середовища"  FontWeight="Bold" />
                <ListBox  x:Name="x_listAllMediums" Grid.Row="1" Margin="5"
                          ItemTemplate="{StaticResource itemsListBox}" />
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="10*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Обрані середовища"  FontWeight="Bold" FontSize="12"/>

                <DataGrid x:Name="x_MainGrid" Grid.Row="1" 
                          ItemsSource="{Binding ListItems}"
                          CanUserAddRows="False">
                  
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Visibility="Collapsed" Binding="{Binding Id}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Номер"  Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridCheckBoxColumn Header="Основне" Binding="{Binding IsMain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Medium.name}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Метод посіву" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <ComboBox ItemsSource="{Binding ListMethodsInoculation}" 
                                              ItemTemplate="{StaticResource itemsComboBox}" 
                                              SelectedItem="{Binding MethodInoculation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Терміни висіву">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TimeTBInoculation, Mode=TwoWay, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}"  Margin="10 0 10 0"/>
                                        <ComboBox ItemsSource="{Binding ListDate}" SelectedItem="{Binding TimeCBInoculation,Mode=TwoWay, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="інкубації">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TimeTBIncubation, Mode=TwoWay, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}"  FontSize="12" FontWeight="Normal" Margin="10 0 10 0"/>
                                        <ComboBox ItemsSource="{Binding ListDate}" SelectedItem="{Binding TimeCBIncubation, Mode=TwoWay, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="спостереження">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate >
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding TimeTBObservation, Mode=TwoWay, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}"  FontSize="12" FontWeight="Normal" Margin="10 0 10 0"/>
                                        <ComboBox ItemsSource="{Binding ListDate}" SelectedItem="{Binding TimeCBObservation, Mode=TwoWay, UpdateSourceTrigger=LostFocus, NotifyOnSourceUpdated=True}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" >
           
            <Button x:Name="x_AddAB" Click="x_Add_Click" ToolTip="Додати"
                VerticalAlignment="Center" >
                <materialDesign:PackIcon Kind="ArrowRightBold" />
            </Button>
            <Button x:Name="x_DelAB" Click="x_Delete_Click"  ToolTip="Видалити"
                    VerticalAlignment="Center" >
                <materialDesign:PackIcon Kind="ArrowLeftBold" />
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button  Click="SaveButton_Click"
                    Command="{x:Static wpf:DialogHost.CloseDialogCommand}" >Зберегти
            </Button>
            <Button IsCancel="True" Margin="8 0 0 0"
                    Command="{x:Static wpf:DialogHost.CloseDialogCommand}" >
                Відмінити
            </Button>
        </StackPanel>
    </Grid>
</UserControl>