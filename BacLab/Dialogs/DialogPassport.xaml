<UserControl x:Class="BacLab.Dialogs.DialogPassport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             mc:Ignorable="d"
             >
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Сформувати паспорт штаму?"  FontSize="16" FontWeight="Bold" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top"  HorizontalAlignment="Left" Margin="10">
            <RadioButton x:Name="x_p1_RB" GroupName="pGroup" Content="резистенти" IsChecked="True" Tag="1" Checked="RB_Checked"/>
            <RadioButton x:Name="x_p2_RB" GroupName="pGroup" Content="поранені ВБД" Tag="2" Checked="RB_Checked"/>
            <RadioButton x:Name="x_p3_RB" GroupName="pGroup" Content="сальмонела на ідентифікацію" Tag="3" Checked="RB_Checked"/>
            <RadioButton x:Name="x_p4_RB" GroupName="pGroup" Content="збудник менінгіту" Tag="4" Checked="RB_Checked"/>
            <RadioButton x:Name="x_p5_RB" GroupName="pGroup" Content="менінгокок" Tag="5" Checked="RB_Checked"/>
            <RadioButton x:Name="x_p6_RB" GroupName="pGroup" Content="дифтерія" Tag="6" Checked="RB_Checked"/>
            <RadioButton x:Name="x_p7_RB" GroupName="pGroup" Content="кашлюк, паракашлюк" Tag="7" Checked="RB_Checked"/>
            <RadioButton x:Name="x_p8_RB" GroupName="pGroup" Content="сповіщення" Tag="8" Checked="RB_Checked"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"  Margin="10" >
            <Button IsDefault="True"  Command="{x:Static wpf:DialogHost.CloseDialogCommand}" Content="Так"
                    Click="Button_Click"/> 

            <Button IsCancel="True" Margin="8 0 0 0" Command="{x:Static wpf:DialogHost.CloseDialogCommand}">
                <Button.CommandParameter>
                    <system:Int32>0</system:Int32>
                </Button.CommandParameter>
                Ні
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
