<UserControl x:Class="BacLab.WorkSpace.ABControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:local="clr-namespace:BacLab.WorkSpace"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance local:ABControl, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <Models:BoolToVisibilityBackConvector x:Key="BoolToVisibilityBackConvector"/>
        <Models:BoolToVisibilityBackConvector2 x:Key="BoolToVisibilityBackConvector2"/>
        <Models:AbSeriesStringConverter2 x:Key="AbSeriesStringConverter2"/>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" >
            <Setter Property="materialDesign:HintAssist.Hint" Value="mm"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="TextAlignment"  Value="Center"/>
            <Setter Property="materialDesign:TextFieldAssist.CharacterCounterVisibility" Value="Collapsed" />
        </Style>

    </UserControl.Resources>

    <Grid x:Name="x_MainGrid" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="40"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Видалити" Click="Delite_Click"></MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>

        <TextBlock Grid.Row="0" Text="{Binding AB.d_Consumables.abbr}" 
                   ToolTip="{Binding AB, Converter={StaticResource AbSeriesStringConverter2}}"/>
        <TextBlock Grid.Row="1" Text="{Binding AB.diapazonMM}"/>
        <TextBox x:Name="x_textBoxPM" Grid.Row="2" materialDesign:HintAssist.Hint="pm" MaxLength="1"
                 Text="{Binding AB.pm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding AB.show, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="x_textBoxPM_PreviewKeyDown"
                 KeyUp="x_textBoxPM_KeyUp"/>
        <TextBox x:Name="x_textBoxMM" Grid.Row="3" materialDesign:HintAssist.Hint="mm" MaxLength="2"
                 Text="{Binding AB.mm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding AB.show, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="x_textBoxMM_PreviewKeyDown"
                 KeyUp="x_textBoxPM_KeyUp"/>

    </Grid>
</UserControl>
