<UserControl x:Class="BacLab.WorkSpace.DateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:WorkSpace="clr-namespace:BacLab.WorkSpace" Loaded="UserControl_Loaded"
             d:DataContext="{d:DesignInstance WorkSpace:DateControl, IsDesignTimeCreatable=False}"
             mc:Ignorable="d" 
             >
    <UserControl.Resources>
        <Models:DateTimeToDateConverter x:Key="DateTimeToDateConverter" />
        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignFloatingHintDatePicker}">
            <Setter Property="Margin" Value="10 0 10 0"/>
            <Setter Property="Language" Value="uk"/>
            <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
            <Setter Property="Margin" Value="10 0 10 0"/>
            <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
        </Style>
        <ControlTemplate x:Key="itemComboBox" >
            <TextBlock Text="{Binding abbr}" />
        </ControlTemplate>
        <DataTemplate x:Key="itemsComboBox">
            <Control Template="{StaticResource itemComboBox}" />
        </DataTemplate>
        
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="1*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <DatePicker Grid.Column="0" x:Name="x_tb_Date"
                    materialDesign:HintAssist.Hint="дата"
                    Text="{Binding Date.date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DateTimeToDateConverter}}">
          
        </DatePicker>

        <ComboBox Grid.Column="1"  x:Name="x_cb_RezTemplateMedium"
                  materialDesign:HintAssist.Hint="характер росту"
                  ItemTemplate="{StaticResource itemsComboBox}"
                  ItemsSource="{Binding ListRezTemplateMedium}"
                  SelectedItem="{Binding Date.d_RezTemplateMedium, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  SelectionChanged="ComboBox_SelectionChanged"/>

        <Button   x:Name="x_addColony" Grid.Row="0" Grid.Column="2" Margin="10 2 2 2"
                  Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                  Background="White" VerticalAlignment="Bottom" 
                  ToolTip="Додати культуру" Width="Auto" Height="Auto"
                  materialDesign:ShadowAssist.ShadowDepth="Depth2"
                  Click="x_addColony_Click" Cursor="Hand">
            <materialDesign:PackIcon Kind="PlusCircleOutline"/>
        </Button>
    </Grid>
</UserControl>
