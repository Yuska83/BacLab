<controls:MetroWindow x:Class="BacLab.WorkSpace.WorkJournalWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                      xmlns:WorkSpace="clr-namespace:BacLab.WorkSpace" 
                      xmlns:Models="clr-namespace:BacLab.Models"
                      WindowStartupLocation="CenterScreen" WindowState="Maximized"  ResizeMode="CanResize"
                      WindowTransitionsEnabled="False" 
                      Title="Робочий журнал"
                      mc:Ignorable="d" Closing="MetroWindow_Closing" 
                      DataContext="RezultProfWindow" 
                      d:DataContext="{d:DesignInstance WorkSpace:WorkJournalWindow, IsDesignTimeCreatable=False}" Icon="/Logo.ico">
   
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width ="1*" />
            <ColumnDefinition Width ="Auto"/>
            <ColumnDefinition Width ="Auto"/>
            <ColumnDefinition Width ="Auto"/>
        </Grid.ColumnDefinitions>

        <Expander Header="ПОШУК" x:Name="x_SeachExpander" Grid.ColumnSpan="4"/>

        <Button Grid.Row="1" Grid.Column="1" materialDesign:HintAssist.Hint="Зберегти"
                Name="x_saveBTN" Click="x_saveBTN_Click">
            <materialDesign:PackIcon Kind="Check"/>
        </Button>
        <Button Grid.Row="1" Grid.Column="2" materialDesign:HintAssist.Hint="Оновити список невиконаних"
                Name="x_refreshBTN" Click="x_refreshBTN_Click">
            <materialDesign:PackIcon Kind="Refresh" />
        </Button>
        <Button Grid.Row="1" Grid.Column="3" materialDesign:HintAssist.Hint="Надрукувати журнал"
                Name="x_printBTN" Click="PrintJournal_Button_Click">
            <materialDesign:PackIcon Kind="PrinterOutline" />
        </Button>

        <materialDesign:DialogHost Identifier="MsgDialog" Grid.Row="2" Grid.ColumnSpan="4">
            <Grid  x:Name="MainGrid" >
                <materialDesign:Card>
                    <TreeView x:Name="x_TreeAnalises" ItemsSource="{Binding Analyzes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                              Background="Transparent" 
                              VerticalAlignment="Stretch"  HorizontalAlignment="Stretch"
                              SelectedItemChanged="SolutionTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
                              PreviewKeyDown="x_TreeAnalises_PreviewKeyDown"
                              >
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem" >
                                <Setter Property="IsExpanded" Value="True" />
                                <EventSetter Event="Loaded" Handler="TreeViewItem_Loaded"/>
                            </Style>
                            <ContextMenu x:Key ="Analis" StaysOpen="true">
                                <MenuItem Name="x_addMedium" Header="Додати середовище" Click="MenuItem_Click"/>
                            </ContextMenu>
                            <ContextMenu x:Key ="Medium" StaysOpen="true">
                                <MenuItem Name="x_addDate" Header="Додати дату" Click="MenuItem_Click"/>
                                <MenuItem Name="x_deleteMedium" Header="Видалити середовище" Click="MenuItem_Click"/>
                            </ContextMenu>
                            <ContextMenu x:Key ="Date" StaysOpen="true">
                                <MenuItem Name="x_deleteDate" Header="Видалити дату" Click="MenuItem_Click"/>
                            </ContextMenu>
                            <ContextMenu x:Key ="Colonie" StaysOpen="true">
                                <MenuItem Name="x_deleteColonie" Header="Видалити колонію" Click="MenuItem_Click"/>
                            </ContextMenu>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate >
                            <HierarchicalDataTemplate ItemsSource="{Binding Items}" >
                                <Label x:Name="x_Label" Content="{Binding Content}"  />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </materialDesign:Card>
            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</controls:MetroWindow>