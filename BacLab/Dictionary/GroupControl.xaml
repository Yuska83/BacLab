<UserControl x:Class="BacLab.Dictionary.GroupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" 
             DataContext="GroupControl"
             d:DataContext="{d:DesignInstance Dictionary:GroupControl,IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ControlTemplate x:Key="itemComboBox" >
                <TextBlock Text="{Binding Abbr}" FontWeight="Normal" FontSize="12" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </ControlTemplate>
            <DataTemplate x:Key="itemsComboBox">
                <Control Template="{StaticResource itemComboBox}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBlock TextAlignment="Center" x:Name="x_tb_GroupName" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="20" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>

        <DataGrid x:Name="x_MainGrid" Grid.Row="1" 
                  ItemsSource="{Binding ListItems}"
                  AddingNewItem="x_MainGrid_AddingNewItem">
            
            <DataGrid.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
            </DataGrid.CommandBindings>

            <DataGrid.Resources>
                <DataTemplate x:Key="GroupReadonly">
                    <TextBlock Text="{Binding Group.Abbr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                               VerticalAlignment="Center"/>
                </DataTemplate>
                <DataTemplate x:Key="GroupEditable">
                    <ComboBox ItemsSource="{Binding ListGroups}" 
                              ItemTemplate="{StaticResource itemsComboBox}" 
                              IsDropDownOpen="True" Background="White"
                              SelectedValue="{Binding Group, Mode=TwoWay, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>

                <DataTemplate x:Key="ItemReadonly">
                    <TextBlock Text="{Binding Item.Abbr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                               VerticalAlignment="Center"/>
                </DataTemplate>
                <DataTemplate x:Key="ItemEditable">
                    <ComboBox ItemsSource="{Binding ListItems}" 
                              ItemTemplate="{StaticResource itemsComboBox}" 
                              IsDropDownOpen="True" Background="White"
                              SelectedValue="{Binding Item, Mode=TwoWay,NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Visibility="Hidden" Header="Id" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="№" IsReadOnly="True" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <DataGridCheckBoxColumn Header="Доступно" Binding="{Binding Show, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}">
                </DataGridCheckBoxColumn>

                <DataGridTemplateColumn Header="Група" SortMemberPath="Group.Abbr" CanUserSort="True"
                                        CellTemplate="{StaticResource GroupReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource GroupReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Show}" Value="True">
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource GroupEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Елемент" SortMemberPath="Item.Abbr" CanUserSort="True"
                                        CellTemplate="{StaticResource ItemReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource ItemReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Show}" Value="True">
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource ItemEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
