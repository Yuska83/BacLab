<UserControl x:Class="BacLab.Dictionary.ResearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Dictionary:ResearchControl,IsDesignTimeCreatable=False}" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ControlTemplate x:Key="itemComboBox" >
                <TextBlock Text="{Binding abbr}" FontWeight="Normal" FontSize="12" />
            </ControlTemplate>
            <DataTemplate x:Key="itemsComboBox">
                <Control Template="{StaticResource itemComboBox}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
       
        <TextBlock Text="Види досліджень" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0"/>
        <CheckBox x:Name="x_cb_visibilityGisCod" Content="ГісКод"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="50 0 0 0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="SaveButton_Click" ToolTip = "Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip = "Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>

        <DataGrid x:Name="x_MainGrid" Grid.Row="1" 
                  ItemsSource="{Binding ListItems}"
                  SelectedItem="{Binding SelectedItem}"
                  SelectionUnit="FullRow"
                  FrozenColumnCount="6"
                  AddingNewItem="x_MainGrid_AddingNewItem">

            <DataGrid.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
            </DataGrid.CommandBindings>

            <DataGrid.Resources>
                <DataTemplate x:Key="GroupReadonly">
                    <TextBlock Text="{Binding Group.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   VerticalAlignment="Center" />
                </DataTemplate>
                <DataTemplate x:Key="GroupEditable">
                    <ComboBox ItemsSource="{Binding ListGroup}" 
                              ItemTemplate="{StaticResource itemsComboBox}" 
                              IsDropDownOpen="True" Background="White"
                              SelectedValue="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
                <DataTemplate x:Key="MaterialReadonly">
                    <TextBlock Text="{Binding Material.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   VerticalAlignment="Center" />
                </DataTemplate>
                <DataTemplate x:Key="MaterialEditable">
                    <ComboBox ItemsSource="{Binding ListMaterial}" 
                                  ItemTemplate="{StaticResource itemsComboBox}" 
                                  IsDropDownOpen="True" Background="White"
                                  SelectedValue="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
                <DataTemplate x:Key="PurposeReadonly">
                    <TextBlock Text="{Binding Purpose.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                   VerticalAlignment="Center" />
                </DataTemplate>
                <DataTemplate x:Key="PurposeEditable">
                    <ComboBox ItemsSource="{Binding ListPurpose}" 
                                  ItemTemplate="{StaticResource itemsComboBox}" 
                                  IsDropDownOpen="True" Background="White"
                                  SelectedValue="{Binding Purpose, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  />
                </DataTemplate>
            </DataGrid.Resources>

            <DataGrid.Columns>
                
                <DataGridTemplateColumn Header="Id" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignDataGridComboBoxEditableTextBox}"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Header="№">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignDataGridComboBoxEditableTextBox}"
                                     IsReadOnly="True"
                                     VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridCheckBoxColumn Header="Доступно" Binding="{Binding Show, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}">
                    <DataGridCheckBoxColumn.CellStyle>
                        <Style>
                            <EventSetter Event="CheckBox.Checked" Handler="ShowCheckBoxChecked"/>
                            <EventSetter Event="CheckBox.Unchecked" Handler="ShowCheckBoxChecked"/>
                        </Style>
                    </DataGridCheckBoxColumn.CellStyle>
                </DataGridCheckBoxColumn>
                
                <DataGridTemplateColumn Header="ГісКод" SortMemberPath="ГісКод" CanUserSort="True" Visibility="Collapsed" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding IdTerraGMP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignDataGridComboBoxEditableTextBox}"
                     VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Абревіатура" SortMemberPath="Абревіатура" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource MaterialDesignDataGridComboBoxEditableTextBox}"
                                     VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Група" SortMemberPath="Група" CanUserSort="True"
                                        CellTemplate="{StaticResource GroupReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource GroupReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Edit}" Value="True">
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource GroupEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Матеріал" SortMemberPath="Матеріал" CanUserSort="True"
                                        CellTemplate="{StaticResource MaterialReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource MaterialReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Edit}" Value="True" >
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource MaterialEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Мета" SortMemberPath="Мета" CanUserSort="True"
                                        CellTemplate="{StaticResource PurposeReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource PurposeReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Edit}" Value="True">
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource PurposeEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn  Header="Середовища"  SortMemberPath="Середовища">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DataGrid x:Name="x_MediumsGrid"  Margin="5"
                                      Focusable="True" Grid.Row="1" 
                                      ItemsSource="{Binding Mediums}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="True"
                                      materialDesign:DataGridAssist.CellPadding="2"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="2"
                                      AllowDrop="True"
                                      SelectionMode="Single"
                                      ScrollViewer.CanContentScroll ="False"
                                      MouseLeftButtonUp="MediumGrid_MouseLeftButtonUp">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Id"  Visibility="Collapsed" Binding="{Binding id}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="№"  Binding="{Binding index}" IsReadOnly="True"/>
                                    <DataGridCheckBoxColumn Header="Основне" Binding="{Binding is_main}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Назва" Binding="{Binding d_Medium.name}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Метод посіву" Binding="{Binding d_MethodsInoculation.name}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Термін висіву" Binding="{Binding timeInoculation}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Термін інкубації" Binding="{Binding timeIncubation}" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Термін спостереження" Binding="{Binding timeObservation}" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Пункт прейскуранту" SortMemberPath="Пункт прейскуранту">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="x_PriceListTextBlock" MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                       Text="{Binding PriceList.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Од.виміру" SortMemberPath="Од.виміру">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"  VerticalAlignment="Center" Margin="15 0 15 0" >
                                <TextBlock Text="МК/см3"  VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center"
                                              IsChecked="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              x:Name="x_toggleButtonMO"  Margin="5 0 5 0"/>
                                <TextBlock Text="КУО/см3" VerticalAlignment="Center"  />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>


                <DataGridTemplateColumn Header="Референтні інтервали" SortMemberPath="Референтні інтервали">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="x_ReferenceIntervalTextBlock" MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                       Text="{Binding ReferenceInterval.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
