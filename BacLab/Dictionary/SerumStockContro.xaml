<UserControl x:Class="BacLab.Dictionary.SerumStockControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             xmlns:Models="clr-namespace:BacLab.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Dictionary:SerumStockControl,IsDesignTimeCreatable=False}" >
    <UserControl.Resources>
        <ResourceDictionary>
            <Models:DateTimeToDateShotConverter x:Key="myDateConverter"/>
            <ControlTemplate x:Key="itemComboBox" >
                <TextBlock Text="{Binding abbr}"/>
            </ControlTemplate>
            <DataTemplate x:Key="itemsComboBox">
                <Control Template="{StaticResource itemComboBox}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock TextAlignment="Center" Text="Облік сироваток"   FontWeight="Bold" FontSize="20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="1">
            <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Click="x_cb_visibilityId_Click" Margin="20 0 0 0" Grid.Column="1" Grid.Row="1"/>
            <ComboBox x:Name="x_cb_serum" VerticalAlignment="Center"
                      ItemTemplate="{StaticResource itemsComboBox}" 
                      materialDesign:HintAssist.Hint="Оберить препарат" 
                      SelectionChanged="x_cb_SelectionChanged"
                      KeyUp="x_ComboBox_KeyUp"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>
        
        <materialDesign:Card Grid.Row="2">
            <DataGrid x:Name="x_MainGrid" 
                      ItemsSource="{Binding ListItems}" 
                      AddingNewItem="x_MainGrid_AddingNewItem"
                      >

                <DataGrid.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
                </DataGrid.CommandBindings>

                <DataGrid.Columns>
                    <DataGridTextColumn IsReadOnly="True" Visibility="Collapsed" Header="Id" Binding="{Binding id}"/>
                    <DataGridCheckBoxColumn Header="В роботі"
                                            Binding="{Binding show, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }"
                                            ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                            EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"
                                            >
                      
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Дата отримання" CanUserSort="True"
                                        Binding="{Binding dateDelivery, Converter={StaticResource myDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        />
                    <DataGridTextColumn Header="Назва препарату" CanUserSort="True" IsReadOnly="True" FontWeight="Bold"
                                        Binding="{Binding d_Serum.abbr, Mode=OneTime, UpdateSourceTrigger=PropertyChanged}"
                                        />
                    
                    <DataGridTemplateColumn Header="Виробник">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ListProducers, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                          ItemTemplate="{StaticResource itemsComboBox}"
                                          SelectedItem="{Binding d_Producer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{StaticResource MaterialDesignDataGridComboBox}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Серія" Binding="{Binding series, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Гідно до" Binding="{Binding termin,Converter={StaticResource myDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                    <DataGridTemplateColumn Header="Висновок">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ListConclusion, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                          SelectedItem="{Binding conclucion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{StaticResource MaterialDesignDataGridComboBox}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
