<UserControl x:Class="BacLab.Dictionary.RoomControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Dictionary:RoomControl, IsDesignTimeCreatable=False}" >
   
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Приміщення" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0" />
        <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button HorizontalAlignment="Right" x:Name="x_UFObtn" Margin="0,0,10,0" 
                    Content="Перерахувати час ламп"  Click="x_UFObtn_Click"/>
            <Button HorizontalAlignment="Right" Margin="0,0,10,0" Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>

        <materialDesign:Card Grid.Row="2">
            <DataGrid x:Name="x_MainGrid" 
                      ItemsSource="{Binding ListItems}" 
                      HorizontalScrollBarVisibility ="Auto"
                      FrozenColumnCount="5"
                      AddingNewItem="x_MainGrid_AddingNewItem">

                <DataGrid.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
                </DataGrid.CommandBindings>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" Visibility="Collapsed" />
                    <DataGridCheckBoxColumn Header="" 
                                        Binding="{Binding Show}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                    <DataGridTextColumn Header="№" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Абревіатура" Binding="{Binding Abbr}" />
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Площа,&#x0a;м&#179;" Binding="{Binding Square}" />
                    <DataGridTextColumn Header="Висота,&#x0a;м." Binding="{Binding Height}" />
                    <DataGridTemplateColumn Header="Температура,&#x0a;&#186;&#67;" SortMemberPath="Temperature">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="x_TemperatureTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                           Text="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Вологість,&#x0a;%" SortMemberPath="Humidity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="x_HumidityTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                           Text="{Binding Humidity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Час роботи&#x0a;УФВ, хв." Binding="{Binding TimeUFO_1}" />
                    <DataGridTextColumn Header="Час роботи УФВ&#x0a;(після 2600год.), хв." Binding="{Binding TimeUFO_2}" />
                    <DataGridTextColumn Header="Час роботи УФВ&#x0a;(після 5300год.), хв." Binding="{Binding TimeUFO_3}" />
                    <DataGridTextColumn Header="Графік ген.&#x0a;прибирань" Binding="{Binding Cleaning}" />
                    <DataGridTemplateColumn Header="Відповідальна&#x0a;особа" SortMemberPath="Staff.name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="x_StaffTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                           Text="{Binding Staff.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Відповідальна особа&#x0a;ген.прибирання" SortMemberPath="StaffCleaning.name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="x_StaffCleaningTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                           Text="{Binding StaffCleaning.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>


