                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="x_RoomCleaning_BTN" Click="PrintButton_Click"  ToolTip ="Обрати" HorizontalAlignment="Right" Margin="0 0 10 0">
                            <materialDesign:PackIcon Kind="Printer" />
                        </Button>
