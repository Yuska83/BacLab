                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Покази,%" >
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
