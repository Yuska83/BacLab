<UserControl x:Class="BacLab.Dictionary.EmailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Dictionary:EmailControl,IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ControlTemplate x:Key="itemComboBox" >
                <TextBlock Text="{Binding abbr}" FontWeight="Normal" FontSize="12" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </ControlTemplate>
            <DataTemplate x:Key="itemsComboBox">
                <Control Template="{StaticResource itemComboBox}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>


        <TextBlock TextAlignment="Center" Text="Електронні адреси закладів"
                   Margin="0,10,0,5" FontWeight="Bold" FontSize="20" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>

        <DataGrid x:Name="x_MainGrid" Grid.Row="1"
                  ItemsSource="{Binding ListItems}"
                  AddingNewItem="x_MainGrid_AddingNewItem">
            
            <DataGrid.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Delete"  Executed="CommandBinding_ExecutedDelete"/>
            </DataGrid.CommandBindings>

            <DataGrid.Resources>
                <DataTemplate x:Key="InstitutionReadonly">
                    <TextBlock Text="{Binding Institution.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                               VerticalAlignment="Center"/>
                </DataTemplate>
                <DataTemplate x:Key="InstitutionEditable">
                    <ComboBox ItemsSource="{Binding ListInstitution}" 
                              ItemTemplate="{StaticResource itemsComboBox}" 
                              IsDropDownOpen="True" Background="White"
                              SelectionChanged="Institution_SelectionChanged" 
                              SelectedValue="{Binding Institution, Mode=TwoWay,NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>

                <DataTemplate x:Key="DepartmentReadonly">
                    <TextBlock Text="{Binding Department.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                               VerticalAlignment="Center"/>
                </DataTemplate>
                <DataTemplate x:Key="DepartmentEditable">
                    <ComboBox ItemsSource="{Binding ListDepartment}" 
                              ItemTemplate="{StaticResource itemsComboBox}" 
                              IsDropDownOpen="True" Background="White"
                              SelectedValue="{Binding Department, Mode=TwoWay,NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Visibility="Hidden" Header="Id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="№" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridCheckBoxColumn Header="Доступно" Binding="{Binding Show, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>

                <DataGridTemplateColumn Header="Заклад" SortMemberPath="Заклад" CanUserSort="True"
                                        CellTemplate="{StaticResource InstitutionReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource InstitutionReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Show}" Value="True">
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource InstitutionEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Відділення" SortMemberPath="Відділення" CanUserSort="True"
                                            CellTemplate="{StaticResource DepartmentReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource DepartmentReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Show}" Value="True">
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource DepartmentEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Email" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridCheckBoxColumn Header="Відправляти" Binding="{Binding IsSend, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                <DataGridCheckBoxColumn Header="Друкувати" Binding="{Binding IsPrint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                <DataGridTextColumn Header="Примітка" Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>

