<UserControl x:Class="BacLab.Dictionary.AdminLabWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" >
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*" />
        </Grid.ColumnDefinitions>
        <GridSplitter Height="Auto" Width="20" Margin="0 10 0 10"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeDirection="Columns"/>
        <materialDesign:Card Grid.Column="0" Margin="10 10 5 10" >

            <StackPanel Orientation="Vertical">
                <Button x:Name="d_Template" Click="Button_Click">Загальні дані</Button>
                <Button x:Name="d_StaffGroup" Click="Button_Click">Категорії персоналу</Button>
                <Button x:Name="d_Staff" Click="Button_Click">Персонал</Button>
                <Button x:Name="d_Room" Click="Button_Click">Приміщення</Button>
                <Button x:Name="d_DragMetal" Click="Button_Click">Дорог.метали</Button>
                <Button x:Name="d_Disinfectants" Click="Button_Click">Дез.засоби</Button>
                <Button x:Name="d_EquipmentState" Click="Button_Click">Стани обладнання</Button>
                <Button x:Name="d_EquipmentGroup" Click="Button_Click">Категорії обладнання</Button>
                <Button x:Name="d_EquipmentMain" Click="Button_Click">Обладнання основне</Button>
                <Button x:Name="d_EquipmentNotMain" Click="Button_Click">Обладнання малоцінне</Button>
                <Button x:Name="d_EquipmentNotShow" Click="Button_Click">Обладнання списане</Button>
                <Button x:Name="d_Room_Equipment_Temperature" Click="Button_Click">Температурний режим</Button>
                <Button x:Name="d_Log" Click="Button_Click">Дії в програмі</Button>
            </StackPanel>
        </materialDesign:Card >
        <materialDesign:Card x:Name="x_MainCard"  Grid.Column="1" Margin="5 10 10 10"/>
    </Grid>
</UserControl>

