<UserControl x:Class="BacLab.Dictionary.ABMonitoringControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Dictionary:ABMonitoringControl,IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <Models:DateTimeToDateShotConverter x:Key="myDateConverter"/>
            <Models:TargetMMConverter x:Key="TargetMMConverter"/>
            <Models:PermissiblemMMConverter x:Key="PermissiblemMMConverter"/>
            <ControlTemplate x:Key="itemComboBox" >
                <TextBlock Text="{Binding name}" VerticalAlignment="Center"/>
            </ControlTemplate>
            <DataTemplate x:Key="itemsComboBox">
                <Control Template="{StaticResource itemComboBox}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <TextBlock TextAlignment="Center" Text="Поточний контроль якості дисків з антибіотиками" Grid.ColumnSpan="2"  FontWeight="Bold" FontSize="20" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0"  Grid.Row="1"/>

        <Button Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
            <materialDesign:PackIcon Kind="Printer"/>
        </Button>


        <ComboBox x:Name="x_cb_antibiotic" ItemTemplate="{StaticResource itemsComboBox}" VerticalAlignment="Center"
                  HorizontalAlignment="Left" materialDesign:HintAssist.Hint="Оберить антибіотик" Width="150"
                  Margin="60 0 0 10" SelectionChanged="x_cb_antibiotic_SelectionChanged"  Grid.Row="1"/>
        <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" Orientation="Horizontal">
            <DatePicker x:Name="x_dateFrom" VerticalAlignment="Top" Margin="10 0 0 0" Width="150" materialDesign:HintAssist.Hint="з"/>
            <DatePicker x:Name="x_dateTo"  VerticalAlignment="Top" Margin="20 0 0 0" Width="150" materialDesign:HintAssist.Hint="по"/>
            <Button x:Name="x_dateBTN" Click="x_dateBTN_Click"  ToolTip ="Обрати" Margin="20 0 0 0">
                <materialDesign:PackIcon Kind="Check" />
            </Button>
        </StackPanel>

        <GridSplitter Height="Auto" Width="20" Margin="0 10 0 10" Grid.Row="2"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeDirection="Columns"/>
        
        <materialDesign:Card Grid.Row="2" >
            <DataGrid x:Name="x_SeriesGrid" 
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionChanged="x_SeriesGrid_SelectionChanged">

                <DataGrid.Columns>
                    <DataGridCheckBoxColumn IsReadOnly="True"
                                        Binding="{Binding show}" 
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding dateDelivery,Converter={StaticResource myDateConverter}}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Виробник" Binding="{Binding d_Producer.abbr}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Серія" Binding="{Binding series}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Термін" Binding="{Binding termin,Converter={StaticResource myDateConverter}}" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <Grid x:Name="x_Grid" Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            
            <GridSplitter Height="Auto" Width="20" Margin="0 10 0 10" Grid.RowSpan="4"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeDirection="Columns"/>
            <materialDesign:Card  Grid.RowSpan="8">
                
                <DataGrid x:Name="x_MainGrid" 
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True">

                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding isEnterControl, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="True">
                                    <Setter Property="Foreground" Value="Cyan" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding isEnterControl, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="False">
                                    <Setter Property="Foreground" Value="Black" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Visibility="Collapsed" Header="Id" Binding="{Binding id}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Дата" Binding="{Binding date, Converter={StaticResource myDateConverter}}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Мікроорганізм" Binding="{Binding d_Microorganism.abbr}" IsReadOnly="True" />
                        <DataGridTextColumn Header="Значення" Binding="{Binding valueCurrent}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontWeight"  Value="Bold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Цільве&#x0a;значення"  IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Converter="{StaticResource TargetMMConverter}"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Допустиме&#x0a;значення" IsReadOnly="True">
                            <DataGridTextColumn.Binding>
                                <Binding Converter="{StaticResource PermissiblemMMConverter}"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Невідповідність" Binding="{Binding comment}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                    <Setter Property="Foreground" Value="Red" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Відповід.особа" Binding="{Binding d_Staff.abbr}" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>

