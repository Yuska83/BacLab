<UserControl x:Class="BacLab.Dictionary.StaffControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" Background="White"
             d:DataContext="{d:DesignInstance Dictionary:StaffControl}">
    <UserControl.Resources>
        <Models:DateTimeToDateShotConverter x:Key="myDateConverter"/>
    </UserControl.Resources>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Персонал лабораторії" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" />
        <CheckBox  x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0" />
        <StackPanel  Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button HorizontalAlignment="Right"  Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>
       
        <materialDesign:Card Grid.Row="2">
            <DataGrid x:Name="x_MainGrid" 
                      ItemsSource="{Binding ListItems}" 
                      HorizontalScrollBarVisibility ="Auto"
                      FrozenColumnCount="5"
                      AddingNewItem="x_MainGrid_AddingNewItem">

                <DataGrid.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
                </DataGrid.CommandBindings>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" Visibility="Collapsed" />
                    <DataGridCheckBoxColumn Header="" 
                                        Binding="{Binding Show, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                    <DataGridTextColumn Header="№" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridCheckBoxColumn Header="Старша" 
                                            Binding="{Binding IsChief, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                            EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                    <DataGridTemplateColumn Header="Посада" SortMemberPath="StaffGroup.name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="x_StaffGroupTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                           Text="{Binding StaffGroup.name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ПІБ" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Абревіатура" Binding="{Binding Abbr}" />
                    <DataGridTextColumn Header="Дата&#x0a;народження" Binding="{Binding Birthday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource myDateConverter}}" />
                    
                    <DataGridTextColumn Header="Адреса" Binding="{Binding Adress}" />
                    <DataGridTextColumn Header="Телефон 1" Binding="{Binding Telephon1}" />
                    <DataGridTextColumn Header="Телефон 2" Binding="{Binding Telephon2}" />
                    <DataGridTextColumn Header="Телефон 3" Binding="{Binding Telephon3}" />
                    <DataGridTextColumn Header="Пароль" Binding="{Binding Parol}" />
                    
                    <DataGridTemplateColumn Header="Відповідальний&#x0a;за сповіщення" SortMemberPath="Staff.name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="x_StaffAlarmTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                           Text="{Binding StaffAlarm.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата&#x0a;прийому на роботу" Binding="{Binding DateEmployment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource myDateConverter}}" />
                    <DataGridTextColumn Header="Дата&#x0a;звільнення" Binding="{Binding DateDismissal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource myDateConverter}}" />
                    
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
