<UserControl x:Class="BacLab.Dictionary.ConsumableAVG"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Dictionary:ConsumableAVG,IsDesignTimeCreatable=False}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="x_nameDictionary" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button HorizontalAlignment="Right" Margin="0,0,10,0" Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>

        <DataGrid x:Name="x_MainGrid" Grid.Row="1" 
                  ItemsSource="{Binding ListItems}"
                  SelectedItem="{Binding SelectedItem}"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Visibility="Collapsed" Header="Id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridCheckBoxColumn Header="замовлення"
                                        Binding="{Binding InOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                <DataGridTextColumn Header="назва" Binding="{Binding Consumable.name}" SortMemberPath="Consumable.name"/>
                <DataGridTextColumn Header="розхід" Binding="{Binding Avg}" SortMemberPath="Avg"/>
                <DataGridTemplateColumn Header="од.вим." SortMemberPath="Unit.abbr" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="x_UnitTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                           Text="{Binding Unit.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="період" SortMemberPath="Period.abbr" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="x_PeriodTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                           Text="{Binding Period.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>