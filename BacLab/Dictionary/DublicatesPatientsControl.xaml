<UserControl x:Class="BacLab.Dictionary.DublicatesPatientsControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:local="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Models:DateTimeToDateConverter x:Key="DateTimeToDateConverter"/>
        <Models:DateTimeToDateTimeConverter x:Key="DateTimeToDateTimeConverter"/>
        <Models:QuantityConverter x:Key="QuantityConverter"/>
        <Models:BoolToYesNoConverter x:Key="BoolToYesNoConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Дублікати пацієнтів" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock x:Name="x_countDublicates"  FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <materialDesign:Card x:Name="SearchCard"  Grid.Row="1">
            <DataGrid x:Name="x_searchGrid" 
                          CanUserAddRows="False"  CanUserDeleteRows="False" IsReadOnly="True"
                          GridLinesVisibility="All" VerticalGridLinesBrush="Gray" HorizontalGridLinesBrush="Gray"
                          FrozenColumnCount="3">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Підрозділ" Binding="{Binding d_Subdivisions.abbr}" Visibility="Visible"/>
                    <DataGridTextColumn Header="№" Binding="{Binding labNum}" />
                    <DataGridTextColumn Header="Дата доставки" Binding="{Binding dateDelivery, Converter={StaticResource DateTimeToDateConverter}}"/>
                    <DataGridTextColumn Header="Заклад" Binding="{Binding d_Institution.abbr}"/>
                    <DataGridTextColumn Header="Відділення"  Binding="{Binding d_Department.abbr}"/>
                    <DataGridTextColumn Header="Паціент" Binding="{Binding d_Patients.name}" />
                    <DataGridTextColumn Header="Рік" Binding="{Binding d_Patients.year}"/>
                    <DataGridTextColumn Header="id" Binding="{Binding d_Patients.id}" />
                    <DataGridTextColumn Header="Адреса" Binding="{Binding d_Patients.adress}"/>
                    <DataGridTemplateColumn >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="x_editBTN" materialDesign:HintAssist.Hint="Редагувати данні"
                                        Click="x_EditBTN_Click">
                                    <materialDesign:PackIcon Kind="LeadPencil" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Діагноз"  Binding="{Binding d_Diagnosis.abbr}"/>
                    <DataGridTextColumn Header="№ медкарти" Binding="{Binding numMedCard}"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding d_PatientStatus.abbr}"/>
                    <DataGridTextColumn Header="Матеріал" Binding="{Binding p_Group_Material_Purpose.d_Material.abbr}"/>
                    <DataGridTextColumn Header="Мета" Binding="{Binding p_Group_Material_Purpose.d_Purpose.abbr}"/>
                    <DataGridCheckBoxColumn Header="Видан" Binding="{Binding sendAnalis, Mode=TwoWay, NotifyOnTargetUpdated=True}" />
                    <DataGridTextColumn Header="Дата завершення" Binding="{Binding timeEnd, Converter={StaticResource DateTimeToDateTimeConverter}}"/>
                    <DataGridTextColumn Header="Лабораторія" Binding="{Binding d_Institution1.abbr}"/>
                    <DataGridTextColumn Header="Реєстратор" Binding="{Binding d_Staff1.abbr}"/>
                    <DataGridTextColumn Header="Ким видано" Binding="{Binding d_Staff.abbr}"/>
                    <DataGridTextColumn Header="Фінансування" Binding="{Binding d_Finance.abbr}"/>
                    <DataGridTextColumn Header="Додатково" Binding="{Binding comment}"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
