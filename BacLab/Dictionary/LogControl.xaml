<UserControl x:Class="BacLab.Dictionary.LogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             xmlns:Models="clr-namespace:BacLab.Models"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Dictionary:LogControl, IsDesignTimeCreatable=False}" >
    <UserControl.Resources>
        <Models:DateTimeToDateConverter x:Key="DateTimeToDateConverter"/>
        <Models:DateTimeToDateTimeConverter x:Key="DateTimeToDateTimeConverter"/>
        <Models:ObjectToVisibilityConvector x:Key="ObjectToVisibilityConvector"/>
        <ControlTemplate x:Key="itemComboBox" >
            <TextBlock Text="{Binding abbr}"/>
        </ControlTemplate>
        <DataTemplate x:Key="itemsComboBox">
            <Control Template="{StaticResource itemComboBox}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логіювання" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0" />
        <StackPanel Grid.Row="1"  Orientation="Horizontal" HorizontalAlignment="Left" >
            <DatePicker Grid.Column="1" Grid.Row="0" Margin="10 0 5 0"
                            x:Name="x_dateDelivery" KeyUp="x_KeyUp"
                            materialDesign:HintAssist.Hint="Дата з" />
            <DatePicker Grid.Column="2" Grid.Row="0" Margin="5 0 10 0"
                            x:Name="x_dateDelivery2" KeyUp="x_KeyUp"
                            materialDesign:HintAssist.Hint="по" />
            <ComboBox Grid.Column="4" Grid.Row="1" 
                          x:Name="x_staff" KeyUp="x_KeyUp"
                          materialDesign:HintAssist.Hint="Особа" 
                          TextSearch.TextPath="abbr"
                          ItemTemplate="{StaticResource itemsComboBox}"/>
            <ComboBox Grid.Column="4" Grid.Row="0" 
                          x:Name="x_action" KeyUp="x_KeyUp"
                          materialDesign:HintAssist.Hint="Дія" 
                          TextSearch.TextPath="abbr"
                          ItemTemplate="{StaticResource itemsComboBox}" />
            <TextBox Grid.Column="2" Grid.Row="2" 
                         x:Name="x_labNum" KeyUp="x_KeyUp"
                         materialDesign:HintAssist.Hint="Лаб.номер аналізу"/>
            <TextBox Grid.Column="2" Grid.Row="2" 
                         x:Name="x_namePacient" KeyUp="x_KeyUp"
                         materialDesign:HintAssist.Hint="ПІБ пацієнта"/>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" x:Name= "x_showBTN"
                    Content="Показати" Click="x_showBTN_Click"/>
        </StackPanel>

        <materialDesign:Card Grid.Row="2">
            <DataGrid x:Name="x_MainGrid"  
                      HorizontalScrollBarVisibility ="Auto" 
                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding id}" IsReadOnly="True" Visibility="Collapsed" />
                    <DataGridTextColumn Header="Дата та час" Binding="{Binding datetime,Converter={StaticResource DateTimeToDateTimeConverter}}" />
                    <DataGridTextColumn Header="ПІБ користувача" Binding="{Binding d_Staff.abbr}" />
                    <DataGridTextColumn Header="Дія" Binding="{Binding d_Action.abbr}" />
                    <DataGridTextColumn Header="Номер аналізу" Binding="{Binding labNum}" />
                    <DataGridTextColumn Header="Дата доставки" Binding="{Binding dateDelivery,Converter={StaticResource DateTimeToDateConverter}}" />
                    <DataGridTextColumn Header="ПІБ пацієнта" Binding="{Binding namePacient}" />
                    <DataGridTemplateColumn Header="Старий бланк" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button  x:Name="x_rezultOld" ToolTip="Показати" HorizontalAlignment="Center" 
                                         VerticalAlignment="Center" Width="15" Height="15"
                                         Click="x_ShowRezult_Click"  
                                         Visibility="{Binding rezultOld, Converter={StaticResource ObjectToVisibilityConvector}}">
                                    <materialDesign:PackIcon Kind="FileDocument" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>