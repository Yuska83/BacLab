<UserControl x:Class="BacLab.Dictionary.AB_All"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Directory="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d"
             DataContext="AB_All"
             d:DataContext="{d:DesignInstance Directory:AB_All,IsDesignTimeCreatable=False}" >
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ControlTemplate x:Key="itemComboBoxAbbr" >
                <TextBlock Text="{Binding abbr}" FontWeight="Normal" FontSize="12" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </ControlTemplate>
            <DataTemplate x:Key="itemsComboBoxAbbr">
                <Control Template="{StaticResource itemComboBoxAbbr}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        
        <TextBlock TextAlignment="Center" Text="Антибіотики та дозування" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="SaveButton_Click" ToolTip = "Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip = "Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>

        <DataGrid x:Name="x_MainGrid" Grid.Row="1"
                  ItemsSource="{Binding ListItems}"
                  AddingNewItem="x_MainGrid_AddingNewItem"
                  FrozenColumnCount="7">

            <DataGrid.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
            </DataGrid.CommandBindings>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" IsReadOnly="True" Visibility="Collapsed"  Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                <DataGridTextColumn Header="№" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridCheckBoxColumn Header="Доступ" Binding="{Binding Show, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}" />
               <DataGridTextColumn Header="Абр" Binding="{Binding Abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Назва" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                
                <DataGridTemplateColumn Header="Група" SortMemberPath="ABGroup.abbr">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="x_ABGroupTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                                       Text="{Binding ABGroup.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--<DataGridTextColumn Header="Розхід" Binding="{Binding Avarage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTemplateColumn Header="в період" SortMemberPath="Period.abbr">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="x_PeriodTextBlock"  MouseLeftButtonUp="x_TextBlock_MouseLeftButtonUp"
                        Text="{Binding Period.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->
                <DataGridTextColumn Header="Стандартна доза ПО" Binding="{Binding DoseStandartPerOr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Стандартна доза ВВ" Binding="{Binding DoseStandart_Vv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Висока доза ПО" Binding="{Binding DoseHighPerOr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Висока доза ВВ" Binding="{Binding DoseHigh_Vv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Примітка"  Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="AcceptsReturn" Value="true" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
