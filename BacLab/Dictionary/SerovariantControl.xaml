<UserControl x:Class="BacLab.Dictionary.SerovariantControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Dictionary:SerovariantControl,IsDesignTimeCreatable=False}" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ControlTemplate x:Key="itemComboBox" >
                <TextBlock Text="{Binding abbr}" FontWeight="Normal" FontSize="12" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </ControlTemplate>
            <DataTemplate x:Key="itemsComboBox">
                <Control Template="{StaticResource itemComboBox}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <TextBlock TextAlignment="Center" Text="Сероваріанти"
                   Margin="10,10,0,5" FontWeight="Bold" FontSize="20" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>

        <DataGrid x:Name="x_MainGrid"  Grid.Row="1" 
                  ItemsSource="{Binding ListItems}" 
                  AddingNewItem="x_MainGrid_AddingNewItem">
            
            <DataGrid.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
            </DataGrid.CommandBindings>

            <DataGrid.Resources>
                <DataTemplate x:Key="MicroorganismGroupReadonly">
                    <TextBlock Text="{Binding MicroorganismGroup.abbr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                </DataTemplate>
                <DataTemplate x:Key="MicroorganismGroupEditable">
                    <ComboBox ItemsSource="{Binding ListMicroorganismGroup}" ItemTemplate="{StaticResource itemsComboBox}" IsDropDownOpen="True" Background="White"
                              SelectionChanged="MicroorganismGroup_SelectionChanged" SelectedValue="{Binding MicroorganismGroup, Mode=TwoWay,NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>

                <DataTemplate x:Key="MicroorganismReadonly">
                    <TextBlock Text="{Binding Microorganism.abbr, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"/>
                </DataTemplate>
                <DataTemplate x:Key="MicroorganismEditable">
                    <ComboBox ItemsSource="{Binding ListMicroorganism}" ItemTemplate="{StaticResource itemsComboBox}" IsDropDownOpen="True" Background="White"
                              SelectedValue="{Binding Microorganism, Mode=TwoWay,NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}" />
                </DataTemplate>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Visibility="Hidden" Header="Id" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" />
                <DataGridTextColumn Header="№" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                <DataGridCheckBoxColumn Header="Доступно" Binding="{Binding Show, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}">
                </DataGridCheckBoxColumn>
                
                <DataGridTemplateColumn Header="Група" SortMemberPath="Група" CanUserSort="True"
                                            CellTemplate="{StaticResource MicroorganismGroupReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource MicroorganismGroupReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Edit}" Value="True">
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource MicroorganismGroupEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Мікроорганізм" SortMemberPath="Мікроорганізм" CanUserSort="True"
                                            CellTemplate="{StaticResource MicroorganismReadonly}">
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ContentPresenter x:Name="Presenter" Content="{Binding}" ContentTemplate="{StaticResource MicroorganismReadonly}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Edit}" Value="True">
                                    <Setter TargetName="Presenter" Property="ContentTemplate" Value="{StaticResource MicroorganismEditable}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Назва" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Серогрупа" Binding="{Binding Sepogroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Підрупа" Binding="{Binding Subspecies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="O_Antigen" Binding="{Binding O_Antigen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="H_phase_1" Binding="{Binding H_Phase_1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="H_phase_2" Binding="{Binding H_Phase_2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Доля" Binding="{Binding Fate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridCheckBoxColumn Header="Старий" Binding="{Binding Old, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>