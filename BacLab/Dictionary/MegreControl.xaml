<UserControl x:Class="BacLab.Dictionary.MegreControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" Background="White" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Dictionary:MegreControl,IsDesignTimeCreatable=False}">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="x_title" Grid.ColumnSpan="2"  FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />

        <materialDesign:Card Grid.Row="2" >
            <DataGrid  x:Name="x_MainDataGrid" 
                       ItemsSource="{Binding ListItems}"
                       SelectedItem="{Binding SelectedItem}"
                       IsReadOnly="True"
                       SelectionMode="Single"
                       SelectionChanged="x_MainDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" IsReadOnly="True" Visibility="Collapsed" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Назва" Binding="{Binding Name}" SortMemberPath="Name"/>
                    <DataGridTextColumn Header="Кіл-ть закладів" Binding="{Binding CountInstitution}" SortMemberPath="CountInstitution"/>
                    <DataGridTextColumn Header="Кіл-ть аналізів" Binding="{Binding CountAnalises}" SortMemberPath="CountAnalises"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="2" Grid.Column="1">
            <materialDesign:DialogHost Identifier="MegreDialog" Margin="10" Background="Aqua" Visibility="Visible">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock x:Name="x_title2" Grid.ColumnSpan="2"  FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <TextBox x:Name="x_name" Grid.Row="1" Margin="10" FontSize="12"
                         Text="{Binding SelectedItem.Name, UpdateSourceTrigger=PropertyChanged}" 
                         TextChanged="x_name_TextChanged"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1">
                        <Button x:Name="x_btn_update" Grid.Column="1" Grid.Row="1" Content="Зберегти" IsEnabled="False"
                            Click="x_btn_update_Click"/>
                        <Button x:Name="x_btn_delete" Margin="10" Content="Видалити" IsEnabled="False"
                            Click="x_btn_delete_Click"/>
                    </StackPanel>

                    <materialDesign:Card Grid.Row="2" Grid.ColumnSpan="2">
                        <ListBox  Margin="10" FontSize="12" x:Name="x_ListInstitutions"
                                  ItemsSource="{Binding SelectedItem.ListInstitutions, UpdateSourceTrigger=PropertyChanged}" 
                                  DisplayMemberPath="Key"/>
                    </materialDesign:Card>
                    <materialDesign:Card Grid.Row="3" Grid.ColumnSpan="2">
                        <TextBlock x:Name="x_info" Margin="10" FontSize="12" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </materialDesign:Card>

                    <TextBlock Text="Замінити на:" Grid.ColumnSpan="2" Grid.Row="4"  FontWeight="Bold"  />
                    <TextBox Grid.Row="5" Grid.Column="0" x:Name="x_abbr" Margin="5,0,5,0"
                             TextChanged="X_abbr_TextChanged" 
                             materialDesign:HintAssist.Hint="Назва" VerticalAlignment="Center"  />
                    <ListBox Grid.Row="6" Grid.Column="0" Margin="5,5,5,5" x:Name="x_nameList" 
                             SelectionChanged="x_searchCB_SelectionChanged"  MaxHeight="100"/>
                    <materialDesign:Card Grid.Row="7" Grid.ColumnSpan="2">
                        <TextBlock x:Name="x_info2" Margin="10" FontSize="12" TextWrapping="Wrap" />
                    </materialDesign:Card>
                    <Button x:Name="x_btn_megre" Content="Об'єднати" Grid.Column="1" Grid.Row="8" HorizontalAlignment="Right" IsEnabled="False"
                        Click="x_btn_megre_Click"/>

                </Grid>
            </materialDesign:DialogHost>
        </materialDesign:Card>
    </Grid>
</UserControl>
