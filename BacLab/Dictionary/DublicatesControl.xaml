<UserControl x:Class="BacLab.Dictionary.DublicatesControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:Models="clr-namespace:BacLab.Models"
             xmlns:local="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ControlTemplate x:Key="itemListBox" >
            <StackPanel Orientation="Horizontal">
                <TextBlock Visibility="Collapsed"  Text="{Binding Id}" />
                <TextBlock Text="{Binding Abbr}" Margin="0 0 5 0"/>
                <TextBlock Text="{Binding Name}" Margin="0 0 5 0"/>
                <TextBlock Text="{Binding GroupName}" Margin="0 0 5 0"/>
                <TextBlock Text="{Binding Count}" Margin="0 0 5 0"/>
            </StackPanel>
        </ControlTemplate>
        <DataTemplate x:Key="itemsListBox">
            <Control Template="{StaticResource itemListBox}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Видалення дублікатів" Grid.ColumnSpan="3"  FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Text="Кількість" x:Name="x_count" Grid.Column="2" Grid.Row="1"  FontWeight="Bold" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <ComboBox x:Name="x_cb_searchField" Grid.Row="1" Grid.Column="0" Width="200"
                  Margin="10,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                  SelectionChanged="x_cb_searchField_SelectionChanged">
            <ComboBoxItem x:Name="x_institution" Content="Мед.заклад"/>
            <ComboBoxItem x:Name="x_department" Content="Відділення"/>
            <ComboBoxItem x:Name="x_diagnos"  Content="Діагноз"/>
            <ComboBoxItem x:Name="x_sentPerson" Content="Осорба, що направила"/>
        </ComboBox>

        <materialDesign:Card Grid.Row="2" >
            <ScrollViewer VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" >
                <ListBox  x:Name="x_ListBoxDublicates" 
                          ItemTemplate="{StaticResource itemsListBox}"/>
            </ScrollViewer>
        </materialDesign:Card>
        <materialDesign:Card Grid.Row="2" Grid.Column="1">
            <ScrollViewer VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                <ListBox  x:Name="x_ListBoxItemsOld" 
                          ItemTemplate="{StaticResource itemsListBox}"/>
            </ScrollViewer>
        </materialDesign:Card>
        <materialDesign:Card Grid.Row="2" Grid.Column="2" >
            <ScrollViewer VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" >
                <ListBox  x:Name="x_ListBoxItemsNew" 
                          ItemTemplate="{StaticResource itemsListBox}"/>
            </ScrollViewer>
        </materialDesign:Card>
        <Button x:Name="x_btn_update" Grid.Row="3" Grid.Column="1" Margin="10"  Click="x_btn_update_Click">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Update"  VerticalAlignment="Center" />
                
                <TextBlock Text="Замінити" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button x:Name="x_btn_delete" Grid.Row="3" Grid.Column="2" Margin="10"  Click="x_btn_delete_Click">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" />
                <TextBlock Text="Видалити" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

    </Grid>
</UserControl>
