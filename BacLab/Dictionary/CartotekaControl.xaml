<UserControl x:Class="BacLab.Dictionary.CartotekaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary" mc:Ignorable="d" Background="White"
             xmlns:Models="clr-namespace:BacLab.Models"
             d:DataContext="{d:DesignInstance Dictionary:CartotekaControl,IsDesignTimeCreatable=False}" >
    <UserControl.Resources>
        <Models:ControlDateHighlightConverter x:Key="ControlDateHighlightConverter"/>
        <Models:DateTimeToDateShotConverter x:Key="myDateConverter"/>
        <ControlTemplate x:Key="itemComboBox" >
            <TextBlock Text="{Binding abbr}"/>
        </ControlTemplate>
        <DataTemplate x:Key="itemsComboBox">
            <Control Template="{StaticResource itemComboBox}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        <TextBlock TextAlignment="Center" Text="Картотека поживних середовищ" Grid.ColumnSpan="5"  FontWeight="Bold" FontSize="20" />
        <TextBox x:Name="x_SearchConcumableBlock" VerticalAlignment="Center" HorizontalAlignment="Stretch" 
                 Margin="10 0 10 10" Grid.Column="0" Grid.Row="1" 
                 materialDesign:HintAssist.Hint="Пошук компонентів"
                 TextChanged="x_SearchConcumableBlock_TextChanged"/>

        <materialDesign:Card Grid.Column="0" Grid.Row="2" Grid.RowSpan="2">
            <ListBox  x:Name="x_ConsumablesList"  Margin="2" SelectionChanged="x_ConsumablesList_SelectionChanged"/>
        </materialDesign:Card>

        <StackPanel Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="2">
            <Button x:Name="x_AddConsumable" Click="x_AddConsumable_Click"  VerticalAlignment="Center" ToolTip="Додати">
                <materialDesign:PackIcon Kind="ArrowRightBold" />
            </Button>
            <Button x:Name="x_DelConsumable" Click="x_DelConsumable_Click"  VerticalAlignment="Center" ToolTip="Видалити">
                <materialDesign:PackIcon Kind="ArrowLeftBold" />
            </Button>
        </StackPanel>

        <TextBox x:Name="x_SearchMediumBlock" VerticalAlignment="Center" 
          HorizontalAlignment="Stretch" Margin="10 0 10 10" Grid.Column="2" Grid.Row="1" 
          materialDesign:HintAssist.Hint="Пошук середовища"
          TextChanged="x_SearchMediumBlock_TextChanged"/>
        <ListBox x:Name="x_MediumList" Grid.Column="2" Grid.Row="2" Margin="2"
                 SelectionChanged="x_MediumList_SelectionChanged" />

        <materialDesign:Card Grid.Column="2" Grid.Row="3" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="x_cb_mediumGroup" ItemTemplate="{StaticResource itemsComboBox}" 
                          materialDesign:HintAssist.Hint="Категорія"
                          Margin="5" Grid.Row="0"  
                          SelectedItem="{Binding SelectedMedium.MediumGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Text= "{Binding SelectedMedium.Abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Скорочена назва"
                         FontWeight="Bold" Margin="5" Grid.Row="0" Grid.Column="1"/>
                <TextBox Text= "{Binding SelectedMedium.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Назва"
                         FontWeight="Bold" Margin="5" Grid.Row="1" Grid.ColumnSpan="2"/>

                <TextBox Text= "{Binding SelectedMedium.MediumGroup.index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="№" IsReadOnly="True"
                         FontWeight="Bold" Margin="5" Grid.Row="0" Grid.Column="2"/>
                
                <TextBox Text= "{Binding SelectedMedium.Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="№"
                         FontWeight="Bold" Margin="5" Grid.Row="1" Grid.Column="2"/>

                <TextBox Text= "{Binding SelectedMedium.Recipe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Рецептура"
                         Margin="5" TextWrapping="Wrap" Grid.Row="3" Grid.ColumnSpan="3"/>
                <ComboBox x:Name="x_cb_sterilization" ItemTemplate="{StaticResource itemsComboBox}" 
                          VerticalAlignment="Center"
                          materialDesign:HintAssist.Hint="стерилізація"
                          Margin="5" Grid.Row="4"  Grid.ColumnSpan="2"
                          SelectedItem="{Binding SelectedMedium.Sterilization, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="x_addSterilization"  HorizontalAlignment="Center" VerticalAlignment="Top" 
                        Grid.Row="4" Grid.Column="2"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        Click="x_addSterilization_Click"
                        ToolTip="Додати" Width="Auto" Height="Auto" 
                        materialDesign:ShadowAssist.ShadowDepth="Depth2"
                        Margin="0,12,0,0">
                    <materialDesign:PackIcon Kind="PlusCircleOutline" />
                </Button>
                <ComboBox x:Name="x_cb_storage" ItemTemplate="{StaticResource itemsComboBox}"
                          materialDesign:HintAssist.Hint="зберігання"
                          Margin="5" Grid.Row="5"  Grid.ColumnSpan="2"
                          SelectedItem="{Binding SelectedMedium.Storage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button x:Name="x_addStorage"  HorizontalAlignment="Center" 
                        VerticalAlignment="Top" Grid.Row="5" Grid.Column="2"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        Click="x_addStorage_Click"
                        ToolTip="Додати" Width="Auto" Height="Auto" 
                        materialDesign:ShadowAssist.ShadowDepth="Depth2"
                        Margin="0,12,0,0">
                    <materialDesign:PackIcon Kind="PlusCircleOutline" />
                </Button>
                <ComboBox x:Name="x_cb_pH" 
                          materialDesign:HintAssist.Hint="pH"
                          Margin="5" Grid.Row="6"  Grid.Column="1"
                          SelectedItem="{Binding SelectedMedium.pH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox x:Name="x_cb_termin" ItemTemplate="{StaticResource itemsComboBox}"
                          materialDesign:HintAssist.Hint="термін"
                          Margin="5" Grid.Row="6" Grid.Column="0"
                          SelectedItem="{Binding SelectedMedium.Termin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox x:Name="x_cb_document" ItemTemplate="{StaticResource itemsComboBox}"
                          materialDesign:HintAssist.Hint="нормативний документ"
                          Margin="5" Grid.Row="8"  Grid.ColumnSpan="3"
                          SelectedItem="{Binding SelectedMedium.Document, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button  x:Name="x_SaveButton" IsDefault="True" Grid.Row="10"
                        Click="x_SaveButton_Click">
                    Зберегти
                </Button>
                <materialDesign:Card Grid.Row="9" Grid.ColumnSpan="3" >
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="10*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Компоненти"  FontWeight="Bold" FontSize="12"/>

                        <!--<DataGrid x:Name="x_MainGrid" Grid.Row="1" 
                                  ItemsSource="{Binding SelectedMedium.ListItems}"
                                  CanUserAddRows="False">
                            <DataGrid.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Delete"  Executed="CommandBinding_Executed"/>
                            </DataGrid.CommandBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Visibility="Collapsed" Binding="{Binding id}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Назва" Binding="{Binding d_Consumable.name}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Кількість" Binding="{Binding quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataGrid.Columns>
                        </DataGrid>-->
                    </Grid>
                </materialDesign:Card>

            </Grid>
        </materialDesign:Card>

        <StackPanel Grid.Column="3" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="2" >
            <Button x:Name="x_AddRecipe" Click="x_AddRecipe_Click"  VerticalAlignment="Center" ToolTip="Додати">
                <materialDesign:PackIcon Kind="ArrowRightBold" />
            </Button>
            <Button x:Name="x_DelRecipe" Click="x_DelRecipe_Click"  VerticalAlignment="Center" ToolTip="Видалити">
                <materialDesign:PackIcon Kind="ArrowLeftBold" />
            </Button>
        </StackPanel>

        <TextBox x:Name="x_SearchRecipeBlock" VerticalAlignment="Center" 
                 HorizontalAlignment="Stretch" Margin="10 0 10 10" Grid.Column="4" Grid.Row="1" 
                 materialDesign:HintAssist.Hint="Пошук рецептури"
                 Text="{Binding ElementName=x_SearchMediumBlock, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="x_SearchRecipeBlock_TextChanged"/>
        <ListBox x:Name="x_RecipeList" Grid.Column="4" Grid.Row="2" Margin="2"
                 SelectionChanged="x_RecipeList_SelectionChanged" MaxHeight="200"/>

        <materialDesign:Card Grid.Column="4" Grid.Row="3" >
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                <TextBox Text= "{Binding SelectedRecipe.ItemId}" FontWeight="Bold" Margin="5"/>
                <TextBox Text= "{Binding SelectedRecipe.Code}" FontWeight="Bold" Margin="5"/>
                <TextBox Text= "{Binding SelectedRecipe.Name}" FontWeight="Bold" Margin="5"/>
                <TextBox Text= "{Binding SelectedRecipe.SourceText}"  Margin="5" TextWrapping="Wrap" Cursor="IBeam"
                         />
            </StackPanel>
        </materialDesign:Card>

    </Grid>
</UserControl>
