<UserControl x:Class="BacLab.Dictionary.ABEnterControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             xmlns:Models="clr-namespace:BacLab.Models"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Dictionary:ABEnterControl,IsDesignTimeCreatable=False}" >
   
    <UserControl.Resources>
        <Models:ControlDateHighlightConverter x:Key="ControlDateHighlightConverter"/>
        <Models:DateTimeToDateShotConverter x:Key="myDateConverter"/>
        <ControlTemplate x:Key="itemComboBox" >
            <TextBlock Text="{Binding name}"/>
        </ControlTemplate>
        <DataTemplate x:Key="itemsComboBox">
            <Control Template="{StaticResource itemComboBox}" />
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock TextAlignment="Center" Text="Облік дисків з антибіотиками"   FontWeight="Bold" FontSize="20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="1">
            <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Click="x_cb_visibilityId_Click" Margin="20 0 0 0" Grid.Column="1" Grid.Row="1"/>
            <ComboBox x:Name="x_cb_antibiotic" VerticalAlignment="Center"
                      ItemTemplate="{StaticResource itemsComboBox}"
                      materialDesign:HintAssist.Hint="Оберити антибіотик" 
                      SelectionChanged="x_cb_antibiotic_SelectionChanged"
                      KeyUp="x_ComboBox_KeyUp"/>
            <DatePicker x:Name="x_dateFrom"  Width="100" 
                materialDesign:HintAssist.Hint="з"  
                HorizontalAlignment="left" Margin="10">
                
            </DatePicker>
            <DatePicker x:Name="x_dateTo"  Width="100" 
                        materialDesign:HintAssist.Hint="по" 
                        HorizontalAlignment="left" Margin="10"/>
            <Button x:Name="x_dateBTN" Click="x_journalBTN_Click"  ToolTip ="Обрати" Margin="20 0 0 0">
                <materialDesign:PackIcon Kind="Check" />
            </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>
        
        <materialDesign:Card Grid.Row="2">
            <DataGrid x:Name="x_MainGrid" 
                      ItemsSource="{Binding ListItems}" 
                      CanUserAddRows="False">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Conclusion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="непридатно">
                                <Setter Property="Foreground" Value="Red" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Conclusion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="придатно">
                                <Setter Property="Foreground" Value="Black" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Conclusion, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Value="">
                                <Setter Property="Foreground" Value="Black" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
                </DataGrid.CommandBindings>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" IsReadOnly="True" Visibility="Collapsed" Binding="{Binding Id}"/>
                    <DataGridTextColumn Header="№" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridCheckBoxColumn Header="В роботі" IsReadOnly="True"
                                            Binding="{Binding Show}"
                                            ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                            EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"
                                            >
                        <DataGridCheckBoxColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Conclusion}" Value="непридатно">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Conclusion}" Value="придатно">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Conclusion}" Value="">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridCheckBoxColumn.CellStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Header="Дата" SortMemberPath="DateDelivery" CanUserSort="True"
                                        Binding="{Binding DateDelivery, Converter={StaticResource myDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        />
                    <DataGridTextColumn Header="Антибіотик" SortMemberPath="AB.name" CanUserSort="True" IsReadOnly="True"
                                        Binding="{Binding AB.name}"/>
                    <DataGridTemplateColumn Header="Виробник">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Producer.abbr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding ListProducers}" IsDropDownOpen="True"
                                          ItemTemplate="{StaticResource itemsComboBox}"
                                          SelectedItem="{Binding Producer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontWeight="Normal" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Серія" Binding="{Binding Series, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Гідно до" Binding="{Binding Termin,Converter={StaticResource myDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <DataGridTextColumn Header="Дата контролю" SortMemberPath="DateControls" CanUserSort="True"
                                        Binding="{Binding DateControls, Converter={StaticResource myDateConverter}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        />
                    <DataGridTemplateColumn Header="Висновок">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Conclusion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding ListConclusion}" IsDropDownOpen="True"
                                          SelectedItem="{Binding Conclusion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          FontWeight="Normal" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
