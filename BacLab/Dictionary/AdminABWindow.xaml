<UserControl x:Class="BacLab.Dictionary.AdminABWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" >
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*" />
        </Grid.ColumnDefinitions>
        <GridSplitter Height="Auto" Width="20" Margin="0 10 0 10"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeDirection="Columns"/>
        <materialDesign:Card Grid.Column="0" Margin="10 10 5 10" >
            <StackPanel Orientation="Vertical">
                <Button x:Name="a_AntibioticGroup" Click="Button_Click">Групи АБ</Button>
                <Button x:Name="x_ABTest" Click="Button_Click">Антибіотики</Button>
                <Button x:Name="x_ABDisk" Click="Button_Click">Диски з антибіотиками</Button>
                <Button x:Name="x_AB_EUCAST" Click="Button_Click">Таблиці(EUCAST)/Панелі</Button>
                <Button x:Name="x_ABResSen" Click="Button_Click">Фенотипи чут/рез</Button>
                <Button x:Name="x_Norms" Click="Button_Click">Цільові значення контролю</Button>
                <Button x:Name="x_EnterControl" Click="Button_Click">Вхідний контроль</Button>
                <Button x:Name="x_ABSeries" Click="Button_Click">Облік серій АБ</Button>
                <Button x:Name="x_Control" Click="Button_Click">Контроль якості АБ</Button>
                <Button x:Name="d_Producer" Click="Button_Click">Виробники АБ</Button>
                <Button x:Name="d_Period" Click="Button_Click">Періоди</Button>
            </StackPanel>
        </materialDesign:Card >
        <materialDesign:Card x:Name="x_MainCard"  Grid.Column="1" Margin="5 10 10 10"/>
    </Grid>
</UserControl>