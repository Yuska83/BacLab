<UserControl x:Class="BacLab.Dictionary.ABNormsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:Dictionary="clr-namespace:BacLab.Dictionary"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Dictionary:ABNormsControl,IsDesignTimeCreatable=False}" >
    <UserControl.Resources>
        <ResourceDictionary>
            <ControlTemplate x:Key="itemComboBox" >
                <TextBlock Text="{Binding abbr}" FontWeight="Normal" FontSize="12" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </ControlTemplate>
            <DataTemplate x:Key="itemsComboBox">
                <Control Template="{StaticResource itemComboBox}" />
            </DataTemplate>

            <ControlTemplate x:Key="itemListBox" >
                <Border HorizontalAlignment="Stretch" Width="200" BorderBrush="Black">
                    <TextBlock Text="{Binding name}" FontSize="12" />
                </Border>
            </ControlTemplate>
            <DataTemplate x:Key="itemsListBox">
                <Control Template="{StaticResource itemListBox}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <TextBlock TextAlignment="Center" Text="Цільові і допустимі значення зон затримки росту контрольних штамів з дисками антибіотиків" Grid.ColumnSpan="2"  FontWeight="Bold" FontSize="20" />
        <CheckBox x:Name="x_cb_visibilityId" Content="Id"  Visibility="Visible" Click="x_cb_visibilityId_Click" Margin="10 0 0 0" Grid.Column="1" Grid.Row="1"/>
        <Button x:Name="x_AllAbBTN" Click="x_AllAbBTN_Click" Content="Всі" HorizontalAlignment="Left" Grid.Column="1" Margin="60 0 0 0" Grid.Row="1"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.ColumnSpan="2" Grid.Row="1">
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="SaveButton_Click" ToolTip ="Зберегти">
                <materialDesign:PackIcon Kind="ContentSave" />
            </Button>
            <Button HorizontalAlignment="Right"  Margin="0,0,10,0" Click="PrintButton_Click" ToolTip="Надрукувати">
                <materialDesign:PackIcon Kind="Printer"/>
            </Button>
        </StackPanel>

        <ComboBox x:Name="x_cb_culture" ItemTemplate="{StaticResource itemsComboBox}" VerticalAlignment="Center"
                  HorizontalAlignment="Left" materialDesign:HintAssist.Hint="Оберить контрольний штам"
                  Margin="130 0 0 10" Grid.Column="1" SelectionChanged="x_CB_Culture_SelectionChanged" Grid.Row="1"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <materialDesign:Card >
                <ListBox  x:Name="x_AllABList"  Margin="2"
                          ItemTemplate="{StaticResource itemsListBox}" >
                </ListBox>
            </materialDesign:Card>
            <StackPanel Grid.Column="1"  HorizontalAlignment="Center" VerticalAlignment="Center" >
                <Button x:Name="x_AddAB" Click="x_AddAB_Click" VerticalAlignment="Center" ToolTip="Додати">
                    <materialDesign:PackIcon Kind="ArrowRightBold" />
                </Button>
                <Button x:Name="x_DelAB" Click="x_DelAB_Click" VerticalAlignment="Center" ToolTip="Видалити">
                    <materialDesign:PackIcon Kind="ArrowLeftBold" />
                </Button>
            </StackPanel>
        </Grid>
        <materialDesign:Card Grid.Row="2" Grid.Column="1">
            <DataGrid x:Name="x_MainGrid"
                  ItemsSource="{Binding ListItems}" 
                  CanUserAddRows="False">

                <DataGrid.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Delete" PreviewCanExecute="CommandBinding_CanExecuteDelete" Executed="CommandBinding_ExecutedDelete"/>
                </DataGrid.CommandBindings>

                <DataGrid.Columns>
                    <DataGridTextColumn IsReadOnly="True" Visibility="Collapsed" Header="Id" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="№" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <DataGridTextColumn Header="Антибіотик" SortMemberPath="Антибіотик" CanUserSort="True" IsReadOnly="True"
                                    Binding="{Binding AB.name}"/>
                    <DataGridTextColumn Header="Мікроорганізм" SortMemberPath="Мікроорганізм" CanUserSort="True" IsReadOnly="True"
                                        Binding="{Binding Microorganism.abbr}"/>


                    <DataGridTextColumn Header="Цільове&#x0a;min" Binding="{Binding ValueTargetMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Цільове&#x0a;max" Binding="{Binding ValueTargetMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Допустиме&#x0a;min" Binding="{Binding ValuePermissiblemMin, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Допустиме&#x0a;max" Binding="{Binding ValuePermissiblemMax, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" >
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

    </Grid>
</UserControl>
