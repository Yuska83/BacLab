<UserControl x:Class="BacLab.Dictionary.AdminInstitutionWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" >
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="9*" />
        </Grid.ColumnDefinitions>
        <GridSplitter Height="Auto" Width="20" Margin="0 10 0 10"
                      HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeDirection="Columns"/>
       
        <materialDesign:Card Grid.Column="0" Margin="10 10 5 10" >
            <StackPanel Orientation="Vertical">
                <Button x:Name="d_Institution" Click="Button_Click">Лікарні</Button>
                <Button x:Name="d_Department" Click="Button_Click">Відділення</Button>
                <Button x:Name="d_Diagnosis" Click="Button_Click">Діагнози</Button>
                <Button x:Name="d_SentPerson" Click="Button_Click">Лікарі</Button>
                <Button x:Name="g_Institution_Department" Click="Button_Click">Лікарні-Відділення</Button>
                <Button x:Name="g_Institution_Person" Click="Button_Click">Лікарні-Лікарі</Button>
                <Button x:Name="g_Institution_Email" Click="Button_Click">Лікарні-Email</Button>
                <Button x:Name="d_Dublicates" Click="Button_Click">Видалення дублікатів</Button>
            </StackPanel>
        </materialDesign:Card >
        <materialDesign:Card x:Name="x_MainCard"  Grid.Column="1" Margin="5 10 10 10"/>
    </Grid>
</UserControl>