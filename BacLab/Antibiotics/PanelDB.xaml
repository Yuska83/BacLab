<UserControl x:Class="BacLab.Antibiotics.PanelDB"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="600">
    <UserControl.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10 0 0 0"/>
        </Style>
        <Style TargetType="StackPanel" >
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10 0 0 0"/>
        </Style>
    </UserControl.Resources>

    <materialDesign:Card>
        <Grid x:Name="x_MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*"/>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Біфідобактерії"  HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"/>
            <Grid Grid.Column="2" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <CheckBox x:Name="x_rbMore1" Checked="x_rb_Checked" >
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </CheckBox>
                    <CheckBox x:Name="x_rbLess1" Checked="x_rb_Checked" >
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </CheckBox>
                </StackPanel>

                <ComboBox  x:Name="x_k1" Grid.Column="1" materialDesign:HintAssist.Hint="Кількість" KeyUp="x_KeyUp">
                    <ComboBox.Items>
                        <ComboBoxItem IsSelected="True">1</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>

                <ComboBox x:Name="x_n1" Grid.Column="2" materialDesign:HintAssist.Hint="*10" KeyUp="x_KeyUp">
                    <ComboBox.Items>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem IsSelected="True">9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>
            </Grid>
            <TextBox x:Name="x_bif" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Лактобактерії" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />
            <Grid Grid.Column="2" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <CheckBox x:Name="x_rbMore2" Checked="x_rb_Checked" >
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </CheckBox>
                    <CheckBox x:Name="x_rbLess2" Checked="x_rb_Checked">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </CheckBox>
                </StackPanel>

                <ComboBox  x:Name="x_k2" Grid.Column="1" KeyUp="x_KeyUp"
                           materialDesign:HintAssist.Hint="Кількість">
                    <ComboBox.Items>
                        <ComboBoxItem IsSelected="True">1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>

                <ComboBox x:Name="x_n2" Grid.Column="2" KeyUp="x_KeyUp"
                          materialDesign:HintAssist.Hint="*10">
                    <ComboBox.Items>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>
            </Grid>
            <TextBox x:Name="x_lac" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="3" Text="E.coli Лак(+)" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />
            <Grid Grid.Column="2" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <CheckBox x:Name="x_rbMore3" Checked="x_rb_Checked" >
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </CheckBox>
                    <CheckBox x:Name="x_rbLess3" Checked="x_rb_Checked">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </CheckBox>
                </StackPanel>

                <ComboBox  x:Name="x_k3" Grid.Column="1" KeyUp="x_KeyUp"
                           materialDesign:HintAssist.Hint="Кількість">
                    <ComboBox.Items>
                        <ComboBoxItem IsSelected="True">1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>

                <ComboBox x:Name="x_n3" Grid.Column="2" KeyUp="x_KeyUp"
                          materialDesign:HintAssist.Hint="*10">
                    <ComboBox.Items>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>
            </Grid>
            <TextBox x:Name="x_lacPlus" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="4" Text="E.coli Лак(+/-)" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />
            <Grid Grid.Column="2" Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <CheckBox x:Name="x_rbMore4" Checked="x_rb_Checked">
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </CheckBox>
                    <CheckBox x:Name="x_rbLess4" Checked="x_rb_Checked">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </CheckBox>
                </StackPanel>

                <ComboBox  x:Name="x_k4" Grid.Column="1" KeyUp="x_KeyUp"
                           materialDesign:HintAssist.Hint="Кількість">
                    <ComboBox.Items>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>

                <ComboBox x:Name="x_n4" Grid.Column="2" KeyUp="x_KeyUp"
                          materialDesign:HintAssist.Hint="*10">
                    <ComboBox.Items>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>
            </Grid>
            <TextBox x:Name="x_lacPlusMinus" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="5" Text="E.coli Лак(-)" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />
            <Grid Grid.Column="2" Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <CheckBox x:Name="x_rbMore5" Checked="x_rb_Checked" >
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </CheckBox>
                    <CheckBox x:Name="x_rbLess5" Checked="x_rb_Checked">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </CheckBox>
                </StackPanel>

                <ComboBox  x:Name="x_k5" Grid.Column="1" KeyUp="x_KeyUp"
                           materialDesign:HintAssist.Hint="Кількість">
                    <ComboBox.Items>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>

                <ComboBox x:Name="x_n5" Grid.Column="2" KeyUp="x_KeyUp"
                          materialDesign:HintAssist.Hint="*10">
                    <ComboBox.Items>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>
            </Grid>
            <TextBox x:Name="x_lacMinus" Grid.Row="5" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="6" Text="Ентерококи" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" />
            <Grid Grid.Column="2" Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <CheckBox x:Name="x_rbMore6" Checked="x_rb_Checked">
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </CheckBox>
                    <CheckBox x:Name="x_rbLess6" Checked="x_rb_Checked">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </CheckBox>
                </StackPanel>

                <ComboBox  x:Name="x_k6" Grid.Column="1" KeyUp="x_KeyUp"
                           materialDesign:HintAssist.Hint="Кількість">
                    <ComboBox.Items>
                        <ComboBoxItem IsSelected="True">1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                        <ComboBoxItem>8</ComboBoxItem>
                        <ComboBoxItem>9</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>

                <ComboBox x:Name="x_n6" Grid.Column="2" KeyUp="x_KeyUp"
                          materialDesign:HintAssist.Hint="*10">
                    <ComboBox.Items>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>
            </Grid>
            <TextBox x:Name="x_ent" Grid.Row="6" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        </Grid>
    </materialDesign:Card>
</UserControl>