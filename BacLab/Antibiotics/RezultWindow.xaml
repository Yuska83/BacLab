<controls:MetroWindow x:Class="BacLab.Antibiotics.RezultWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                      xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
                      xmlns:Models="clr-namespace:BacLab.Models"
                      xmlns:Antibiotics="clr-namespace:BacLab.Antibiotics" 
                      WindowStartupLocation="CenterScreen" WindowState="Maximized"  ResizeMode="CanResize"
                      WindowTransitionsEnabled="False"
                      Icon="/Resources/Logo.ico" 
                      mc:Ignorable="d" Closing="MetroWindow_Closing" 
                      DataContext="RezultWindow"
                      d:DataContext="{d:DesignInstance Antibiotics:RezultWindow, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <Models:DateTimeToDateConverter x:Key="DateTimeToDateConverter" />
        <Models:CulturesToStringlConverter x:Key="CulturesToStringlConverter"/>
        
        <ControlTemplate x:Key="itemComboBox" >
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding abbr}" />
            </StackPanel>
        </ControlTemplate>
        <DataTemplate x:Key="itemsComboBox">
            <Control Template="{StaticResource itemComboBox}" />
        </DataTemplate>
    </Window.Resources>
    
    <materialDesign:DialogHost Identifier="MsgDialog">
        <Grid  x:Name="MainGrid" >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
       
        <materialDesign:Card Margin="10 10 10 5">
                <DataGrid x:Name="x_listAnalisesGrid"
                          ItemsSource="{Binding Analyzes}"
                          SelectedItem="{Binding Selected_d_Analis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionChanged="x_listAnalisesGrid_SelectionChanged">

                <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding dateDelivery,Converter={StaticResource DateTimeToDateConverter}}" />
                    <DataGridTextColumn Header="Лаб№" Binding="{Binding labNum}" />
                    <DataGridTextColumn Header="ПІБ" Binding="{Binding d_Patients.name}" />
                    <DataGridTextColumn Header="Рік" Binding="{Binding d_Patients.year}" />
                    <DataGridTextColumn Header="Матеріал" Binding="{Binding p_Group_Material_Purpose.d_Material.abbr}"/>
                    <DataGridTextColumn Header="Мета" Binding="{Binding p_Group_Material_Purpose.d_Purpose.abbr}"/>
                    <DataGridTextColumn Header="Заклад" Binding="{Binding d_Institution.abbr}" />
                    <DataGridTextColumn Header="Відділення" Binding="{Binding d_Department.abbr}" />
                        <DataGridTextColumn Header="Коментар" Binding="{Binding comment}" />
                        <DataGridTextColumn Header="Лабораторія" Binding="{Binding d_Institution1.abbr}" />
                    </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>


        <materialDesign:Card Grid.Row="1" Grid.Column="0" VerticalAlignment="Stretch" Margin="10 5 10 10">
            <Grid x:Name="x_analisGrid" >
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="0.5*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                    <DatePicker Grid.Column="1" Grid.Row="0" IsEnabled="False"
                                x:Name="x_dateDelivery" 
                                materialDesign:HintAssist.Hint="Дата доставки">
                        <DatePicker.SelectedDate>
                            <Binding Path="Analis.DateDelivery"/>
                        </DatePicker.SelectedDate>
                    </DatePicker>

                    <TextBox Grid.Column="1" Grid.Row="1" IsEnabled="False"
                             materialDesign:HintAssist.Hint="Лаб.№" 
                             Text="{Binding Analis.LabNum}"/>

                    <TextBox Grid.Column="1" Grid.Row="2" IsEnabled="False"
                         materialDesign:HintAssist.Hint="ПІБ"
                         Text="{Binding Analis.d_Patient.name}"/>

                    <TextBox Grid.Column="1" Grid.Row="3" IsEnabled="False"
                         materialDesign:HintAssist.Hint="Рік народження"
                         Text="{Binding Analis.d_Patient.year}"/>

                    <TextBox Grid.Column="1" Grid.Row="4" IsEnabled="False"
                         materialDesign:HintAssist.Hint="Матеріал"
                         Text="{Binding Analis.GMP.d_Material.abbr}"/>

                    <TextBox Grid.Column="1" Grid.Row="5" IsEnabled="False"
                         materialDesign:HintAssist.Hint="Мета"
                         Text="{Binding Analis.GMP.d_Purpose.abbr}"/>

                    <TextBox Grid.Column="1" Grid.Row="6" IsEnabled="False"
                         materialDesign:HintAssist.Hint="Статус паціента" 
                         Text="{Binding Analis.PatientStatus.abbr}"/>

                    <DatePicker Grid.Column="3" Grid.Row="0"
                            x:Name="x_dateEnd" 
                            materialDesign:HintAssist.Hint="Дата виписки">
                        <DatePicker.SelectedDate>
                            <Binding Path="Analis.DateEnd" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
                        </DatePicker.SelectedDate>
                    </DatePicker>

                    <TextBox Grid.Column="3" Grid.Row="1" IsEnabled="False"
                         materialDesign:HintAssist.Hint="Заклад" 
                         Text="{Binding Analis.Institution.abbr}"/>
                    <TextBox Grid.Column="3" Grid.Row="2" IsEnabled="False"
                         materialDesign:HintAssist.Hint="Відділення" 
                         Text="{Binding Analis.Department.abbr}"/>

                    <ComboBox Grid.Column="3" Grid.Row="3"
                              x:Name="x_result"
                              materialDesign:HintAssist.Hint="Результат" 
                              ItemTemplate="{StaticResource itemsComboBox}"
                              SelectedItem="{Binding Analis.ResTemplate, Mode =TwoWay,  UpdateSourceTrigger=PropertyChanged}"
                              SelectionChanged="x_result_SelectionChanged"/>

                    <ComboBox Grid.Column="3" Grid.Row="4"
                          x:Name="x_MicroorganismGroup"
                          materialDesign:HintAssist.Hint="Група"
                          ItemTemplate="{StaticResource itemsComboBox}"
                          SelectedItem="{Binding MOGroup, Mode =TwoWay,  UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="X_MicroorganismGroup_SelectionChanged"/>

                    <Button Grid.Column="3" Grid.Row="5" 
                            x:Name="x_addCultureBtn" IsEnabled="False"
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Click="x_addCultureBtn_Click" >Додати</Button>

                    <Button Grid.Column="3" Grid.Row="6" 
                            x:Name="x_saveBtn" IsEnabled="True"
                            Click="x_saveBtn_Click" >Відправити</Button>
                    <StackPanel Grid.Column="3" Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Left" >
                        <CheckBox  Visibility="Visible" 
                            x:Name="x_noPrint" IsChecked="{Binding NoPrint}" >
                            <materialDesign:PackIcon Kind="PrinterOff" />
                        </CheckBox>
                        <CheckBox  Visibility="Visible" 
                                   x:Name="x_noEmail" IsChecked="{Binding NoEmail}" >
                            <materialDesign:PackIcon Kind="EmailOff" />
                        </CheckBox>
                    </StackPanel>

                    <Button Grid.Column="3" Grid.Row="5" 
                        x:Name="x_editBtn" ToolTip="Редагувати данні"
                        HorizontalAlignment="Left" IsEnabled="False"
                        VerticalAlignment="Center"
                        Click="x_editBtn_Click" >
                    <materialDesign:PackIcon Kind="LeadPencil" />
                </Button>
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="0" Grid.Column="1" Margin="10 10 10 5">

            <materialDesign:DialogHost Identifier="x_dlgHostResult">

                <DataGrid x:Name="x_patientAnalisisGrid"
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          IsReadOnly="True" >

                    <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding dateDelivery,Converter={StaticResource DateTimeToDateConverter}}" />
                        <DataGridTextColumn Header="Номер" Binding="{Binding labNum}" />
                        <DataGridTextColumn Header="Матеріал" Binding="{Binding p_Group_Material_Purpose.d_Material.abbr}"/>
                        <DataGridTextColumn Header="Мета" Binding="{Binding p_Group_Material_Purpose.d_Purpose.abbr}"/>
                        <DataGridTextColumn Header="Результат" Binding="{Binding d_ResTemplate.abbr}"/>
                            <DataGridTextColumn Header="Культури" Binding="{Binding p_Analises_Cultures, Converter={StaticResource CulturesToStringlConverter} }"/>
                            <DataGridTemplateColumn Header="Бланк" >
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button x:Name="x_printBTN" 
                                            Click="x_ShowRezult_Click"  IsEnabled="{Binding sendAnalis}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Коментар" Binding="{Binding comment}"/>
                        <DataGridTextColumn Header="Підрозділ" Binding="{Binding d_Subdivisions.abbr}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:DialogHost>
        </materialDesign:Card>

        <materialDesign:Card x:Name="x_dinamicResCard" IsEnabled="False" Margin="10 5 10 10"
                             Grid.Row="1" Grid.Column="2"  VerticalAlignment="Stretch" >
                <dragablz:TabablzControl  x:Name="x_resTab" IsEnabled="False" 
                             BorderThickness="2" TabStripPlacement="Left">
                    <dragablz:TabablzControl.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Видалити" x:Name="dltTabItem" Click="dltTabItem_Click"></MenuItem>
                    </ContextMenu>
                </dragablz:TabablzControl.ContextMenu>
            </dragablz:TabablzControl>
        </materialDesign:Card>

       
            
    </Grid>
    </materialDesign:DialogHost>
</controls:MetroWindow>