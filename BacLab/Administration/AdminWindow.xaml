<controls:MetroWindow x:Class="BacLab.Administration.AdminWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
                      xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
                      WindowTransitionsEnabled="False"
                      Title="Адміністрування" 
                      WindowStartupLocation="CenterScreen" 
                      WindowState="Maximized" ResizeMode="CanResize"
                      Closing="MetroWindow_Closing" Icon="/Resources/Logo.ico">

    <materialDesign:DialogHost Identifier="MsgDialog" >
        <dockablz:Layout>
            <DockPanel >
                <dragablz:TabablzControl BorderThickness="2" >
                    <TabItem Header="Лабораторія" x:Name="x_LabTabItem"/>
                    <TabItem Header="Заклади" x:Name="x_InstitutionTabItem"/>
                    <TabItem Header="Дослідження" x:Name="x_ReserchTabItem"/>
                    <TabItem Header="Мікроорганізми" x:Name="x_MOTabItem"/>
                    <TabItem Header="Антибіотики" x:Name="x_ABTabItem"/>
                    <TabItem Header="Паціенти" x:Name="x_PatientTabItem"/>
                </dragablz:TabablzControl>
            </DockPanel>
        </dockablz:Layout>
    </materialDesign:DialogHost>
</controls:MetroWindow>

