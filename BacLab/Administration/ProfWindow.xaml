<controls:MetroWindow x:Class="BacLab.Administration.ProfWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Administration="clr-namespace:BacLab.Administration"
                      xmlns:Models="clr-namespace:BacLab.Models"
                      mc:Ignorable="d" Icon="/Resources/Logo.ico" Title="ПРОФПУНКТ" 
                      WindowStartupLocation="CenterScreen" WindowState="Maximized"  ResizeMode="CanResize"
                      DataContext="ProfWindow"
                      d:DataContext="{d:DesignInstance Administration:ProfWindow,IsDesignTimeCreatable=False}"
                      WindowTransitionsEnabled="False" Closing="MetroWindow_Closing">

    <Window.Resources>
        <Models:DateTimeToDateConverter x:Key="DateTimeToDateConverter" />
        <Models:StringToIntConverter x:Key="StringToIntConverter"/>
        <Models:CountToBoolConverter x:Key="CountToBoolConverter"/>
        <Models:CulturesToStringlConverter x:Key="CulturesToStringlConverter"/>
        <Models:QuantityConverter x:Key="QuantityConverter"/>
        <ControlTemplate x:Key="itemComboBox" >
            <TextBlock Text="{Binding abbr}" />
        </ControlTemplate>
        <DataTemplate x:Key="itemsComboBox">
            <Control Template="{StaticResource itemComboBox}" />
        </DataTemplate>
        <ControlTemplate x:Key="itemListAbbr" >
            <TextBlock Text="{Binding abbr}" />
        </ControlTemplate>
        <DataTemplate x:Key="itemsListAbbr">
            <Control Template="{StaticResource itemListAbbr}" />
        </DataTemplate>
        <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}">
            <Setter Property="Margin" Value="10 0 0 0"/>
            <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <ItemsPanelTemplate x:Key="itemsPanelTemplate">
            <WrapPanel Height="150" Width="Auto"
                       Orientation="Vertical" Background="White" 
                       ScrollViewer.VerticalScrollBarVisibility="Disabled" 
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </ItemsPanelTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="MsgDialog" Margin="10" >
        <Grid x:Name="MainGrid" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width ="Auto" />
                <ColumnDefinition Width ="1*"/>
            </Grid.ColumnDefinitions>
            <GridSplitter Height="Auto" Width="20" Margin="0 10 0 10" Grid.RowSpan="2" 
                          HorizontalAlignment="Right" VerticalAlignment="Stretch" ResizeDirection="Columns"/>

            <materialDesign:Card >
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <materialDesign:DialogHost Identifier="x_dlgHostResult" Margin="10" >
                        <Grid ScrollViewer.CanContentScroll="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Grid.Row="0" x:Name="x_labNum" 
                         Text="{Binding Analis.labNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,Converter={StaticResource StringToIntConverter} }"
                         materialDesign:HintAssist.Hint="Номер"/>

                            <DatePicker Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                    materialDesign:HintAssist.Hint="Дата забору" 
                                    SelectedDate="{Binding Analis.dateSampling, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            </DatePicker>

                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="x_name"
                         materialDesign:HintAssist.Hint="ПІБ"
                         Text="{Binding Analis.d_Patients.name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         TextChanged="x_tbName_TextChanged"/>

                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="x_yearOfBirth" 
                         Text="{Binding Analis.d_Patients.year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToIntConverter}}"
                         materialDesign:HintAssist.Hint="Рік народження"/>

                            <StackPanel VerticalAlignment="Bottom" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left">
                                <RadioButton x:Name="x_maleRB" GroupName="sexGroup" Content="ч" Checked="x_male_Checked"/>
                                <RadioButton x:Name="x_fameRB" GroupName="sexGroup" Content="ж" Checked="x_male_Checked"/>
                            </StackPanel>

                            <TextBox Grid.Row="2" Grid.Column="0" x:Name="x_adress" Grid.ColumnSpan="3"
                         Text="{Binding Analis.d_Patients.adress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Адреса"/>

                            <TextBox Grid.Row="3" Grid.Column="0" x:Name="x_phone" 
                         Text="{Binding Analis.d_Patients.phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="Телефон"/>

                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="x_email"  Grid.ColumnSpan="2"
                         Text="{Binding Analis.d_Patients.email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         materialDesign:HintAssist.Hint="e-mail"/>

                            <materialDesign:Card x:Name="SearchCard" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" MaxHeight="200" >
                                <DataGrid x:Name="x_PatientSearchGrid" 
                                      CanUserAddRows="False"
                                      materialDesign:DataGridAssist.CellPadding="2"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="2"
                                      SelectedCellsChanged="x_PatientSearch_SelectedCellsChanged" >
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Паціент" IsReadOnly="True" Binding="{Binding name}" />
                                        <DataGridTextColumn Header="Рік" IsReadOnly="True" Binding="{Binding year}"/>
                                        <DataGridTextColumn Header="Адреса" IsReadOnly="True" Binding="{Binding adress}"/>
                                        <DataGridTextColumn Header="Телефон" IsReadOnly="True" Binding="{Binding phone}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </materialDesign:Card>


                            <ComboBox Grid.Row="5" Grid.Column="0" x:Name="x_Finance"
                                  materialDesign:HintAssist.Hint="Фінансування:" 
                                  TextSearch.TextPath="abbr"
                                  ItemTemplate="{StaticResource itemsComboBox}"
                                  SelectedItem="{Binding Analis.d_Finance}"/>
                            <ComboBox Grid.Row="6" Grid.Column="0" x:Name="x_WhoPay"
                                  materialDesign:HintAssist.Hint="Сплачує:" 
                                  TextSearch.TextPath="abbr"
                                  ItemTemplate="{StaticResource itemsComboBox}"
                                  SelectedItem="{Binding Analis.d_WhoPay}"/>
                            <ComboBox Grid.Row="7" Grid.Column="0" x:Name="x_JobStatus"
                                  materialDesign:HintAssist.Hint="Статус:" 
                                  TextSearch.TextPath="abbr"
                                  ItemTemplate="{StaticResource itemsComboBox}"
                                  SelectedItem="{Binding Analis.d_JobStatus}"/>
                            <ComboBox Grid.Row="8" Grid.Column="0" x:Name="x_JobPlaceGroup"
                                  materialDesign:HintAssist.Hint="Категорія:" 
                                  TextSearch.TextPath="abbr"
                                  ItemTemplate="{StaticResource itemsComboBox}"
                                  SelectedItem="{Binding Analis.d_JobPlaceGroup}"/>

                            <materialDesign:Card Grid.Row="10" Grid.Column="0" >
                                <StackPanel>
                                    <CheckBox  Content="Сплачено" 
                                  IsChecked="{Binding Analis.isPay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Content="Видано"  x:Name="x_isIssued"
                                  IsChecked="{Binding Analis.isVydano, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Checked="x_isVydano_Checked" Unchecked="x_isVydano_Unchecked"/>
                                </StackPanel>
                            </materialDesign:Card>

                            <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                 x:Name="x_JobPlace" Margin="5"
                                 TextChanged="x_JobPlace_TextChanged" 
                                 materialDesign:HintAssist.Hint="Місце роботи"  />

                            <ListBox Grid.Row="6" Grid.Column="1" Margin="5" Grid.ColumnSpan="2"
                                 x:Name="x_JobPlaceList" 
                                 SelectionChanged="x_JobPlaceList_SelectionChanged" 
                                 MaxHeight="600"/>

                            <ComboBox Grid.Row="7" Grid.Column="1" x:Name="x_Dictrict" Grid.ColumnSpan="2"
                                  materialDesign:HintAssist.Hint="Район" 
                                  TextSearch.TextPath="abbr" 
                                  ItemTemplate="{StaticResource itemsComboBox}"
                                  />

                            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                 x:Name="x_Job" Margin="5"
                                 
                                 TextChanged="x_Job_TextChanged" 
                                 materialDesign:HintAssist.Hint="Місце роботи"  />
                            <ListBox Grid.Row="9" Grid.Column="1" Margin="5" Grid.ColumnSpan="2"
                                 x:Name="x_JobList" 
                                 SelectionChanged="x_JobList_SelectionChanged" 
                                 MaxHeight="600"/>

                            <materialDesign:Card Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2">
                                <StackPanel>
                                    <CheckBox  x:Name="x_pat" Content="Кишкова" IsChecked="True"/>
                                    <CheckBox  x:Name="x_st"  Content="Стафілокок" />
                                </StackPanel>
                            </materialDesign:Card>

                            <Button Grid.Row="11" Grid.Column="1" x:Name="x_saveBTN"  Grid.ColumnSpan="2"
                                Click="x_saveBTN_Click">Зберегти</Button>

                            <Button Grid.Row="11" Grid.Column="0" x:Name="x_editBTN" Visibility="Collapsed"
                                Click="x_saveBTN_Click">Зберегти</Button>
                            <Button Grid.Row="11" Grid.Column="1" x:Name="x_addBTN" Visibility="Collapsed" Grid.ColumnSpan="2"
                                Click="x_saveBTN_Click">Додати</Button>
                            <Button Grid.Row="12" Grid.Column="0" x:Name="x_clearBTN" Visibility="Collapsed"
                                Click="x_clearBTN_Click">Очистити</Button>
                            <Button Grid.Row="12" Grid.Column="1" x:Name="x_deleteBTN" Visibility="Collapsed" Grid.ColumnSpan="2"
                                Click="X_deleteBTN_Click">Видалити</Button>

                        </Grid>
                    </materialDesign:DialogHost>
                </ScrollViewer>
            </materialDesign:Card>
               

            <materialDesign:Card Grid.Row="0" Grid.Column="1" Margin="5 10 10 10 ">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="1" Margin="10 10 10 10" >
                        <DataGrid x:Name="x_listAnalisesGrid"
                          ItemsSource="{Binding Analyzes}"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionChanged="x_listAnalisesGrid_SelectionChanged">

                            <DataGrid.Columns>
                                <!--<DataGridCheckBoxColumn Header="Видано" Binding="{Binding isVydano, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False"
                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>-->

                                
                                <DataGridTextColumn Header="Лаб№" Binding="{Binding labNum}" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding dateSampling,Converter={StaticResource DateTimeToDateConverter}}" />
                                <DataGridTextColumn Header="Матеріал" Binding="{Binding p_Group_Material_Purpose.d_Material.abbr}" />
                                <DataGridTextColumn Header="Мета" Binding="{Binding p_Group_Material_Purpose.d_Purpose.abbr}" />
                                <DataGridTextColumn Header="ПІБ" Binding="{Binding d_Patients.name}" />
                                <DataGridTextColumn Header="Рік" Binding="{Binding d_Patients.year}" />
                                <DataGridTextColumn Header="Адрес" Binding="{Binding d_Patients.adress}"/>
                                <DataGridTextColumn Header="Район" Binding="{Binding d_JobPlace.d_District.abbr}" />
                                <DataGridTextColumn Header="Місце роботи" Binding="{Binding d_JobPlace.abbr}" />
                                <DataGridTextColumn Header="Посада" Binding="{Binding d_Job.abbr}" />
                                <DataGridTextColumn Header="Фінансування" Binding="{Binding d_Finance.abbr}"/>
                                <DataGridTextColumn Header="Сплачує" Binding="{Binding d_WhoPay.abbr}"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding d_JobStatus.abbr}"/>
                                <DataGridTextColumn Header="Категорія" Binding="{Binding d_JobPlaceGroup.abbr}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>

                    <Expander Grid.Row="2"  x:Name="x_SeachExpander">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ПОШУК" Grid.Column="0" FontSize="16" VerticalAlignment="Center" FontFamily="{StaticResource MaterialDesignFont}"/>
                                <Button Grid.Column="1" materialDesign:HintAssist.Hint="Оновити список виконаних"
                                        Click="RefreshButton_Click">
                                    <materialDesign:PackIcon Kind="Refresh" />
                                </Button>
                                <Button Grid.Column="2" x:Name="x_saveAllAnalisis"  materialDesign:HintAssist.Hint="Зберегти"
                                        Click="SaveAllAnalisisButton_Click">
                                    <materialDesign:PackIcon Kind="Check" />
                                </Button>
                                <Button Grid.Column="3" materialDesign:HintAssist.Hint="Друкувати"
                                        Click="Print_Button_Click">
                                    <materialDesign:PackIcon Kind="Printer" />
                                </Button>
                            </Grid>
                        </Expander.Header>
                    </Expander>

                    <materialDesign:Card Grid.Row="3"  Margin="10" >
                        <DataGrid x:Name="x_listAnalisesReadyGrid"
                                  ItemsSource="{Binding AnalyzesReady}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionChanged="x_listAnalisesGrid_SelectionChanged">
                            
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding p_Analises_Cultures,Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CountToBoolConverter}}"  Value="True">
                                            <Setter Property="Foreground" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding p_Analises_Cultures, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource CountToBoolConverter}}" Value="False">
                                            <Setter Property="Foreground" Value="Black" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Завершено" Binding="{Binding isEnd}" ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                                <DataGridCheckBoxColumn Header="Сплачено" Binding="{Binding isPay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False"
                                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>

                                <DataGridCheckBoxColumn Header="Видано" Binding="{Binding isVydano, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False"
                                                        ElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnStyle}"
                                                        EditingElementStyle="{StaticResource MaterialDesignDataGridCheckBoxColumnEditingStyle}"/>
                                
                                <DataGridTextColumn Header="Лаб№" Binding="{Binding labNum}"  FontWeight="Bold"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding dateSampling,Converter={StaticResource DateTimeToDateConverter}}"  />
                                <DataGridTextColumn Header="ПІБ" Binding="{Binding d_Patients.name}" />
                                <DataGridTextColumn Header="Рік" Binding="{Binding d_Patients.year}" />
                                <DataGridTextColumn Header="Дата завершення" Binding="{Binding dateEnd, Converter={StaticResource DateTimeToDateConverter}}"/>
                                <DataGridTextColumn Header="Результат" Binding="{Binding d_ResTemplate.abbr}"/>
                                <DataGridTextColumn Header="Культури" Binding="{Binding p_Analises_Cultures, Converter={StaticResource CulturesToStringlConverter} }"/>
                                <DataGridTextColumn Header="Матеріал" Binding="{Binding p_Group_Material_Purpose.d_Material.abbr}" />
                                <DataGridTextColumn Header="Мета" Binding="{Binding p_Group_Material_Purpose.d_Purpose.abbr}" />
                                <DataGridTextColumn Header="Місце роботи" Binding="{Binding d_JobPlace.abbr}" />
                                <DataGridTextColumn Header="Посада" Binding="{Binding d_Job.abbr}" />
                                <DataGridTextColumn Header="Статус" Binding="{Binding d_JobStatus.abbr}"/>
                                <DataGridTextColumn Header="Категорія" Binding="{Binding d_JobPlaceGroup.abbr}"/>
                                <DataGridTextColumn Header="Фінансування" Binding="{Binding d_Finance.abbr}"/>
                                <DataGridTextColumn Header="Сплачує" Binding="{Binding d_WhoPay.abbr}"/>
                                <DataGridTextColumn Header="Ким зареєстровано" Binding="{Binding d_Staff1.abbr}"/>
                                <DataGridTextColumn Header="Ким завершено" Binding="{Binding d_Staff.abbr}"/>
                                <DataGridTextColumn Header="Ким видано" Binding="{Binding d_Staff2.abbr}"/>
                                <DataGridTextColumn Header="Дата видачі" Binding="{Binding dateVydano,Converter={StaticResource DateTimeToDateConverter}}"/>

                            </DataGrid.Columns>
                        </DataGrid>
                    </materialDesign:Card>

                </Grid>
            </materialDesign:Card>
        </Grid>
    </materialDesign:DialogHost>
</controls:MetroWindow>