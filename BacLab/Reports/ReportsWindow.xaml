<controls:MetroWindow x:Class="BacLab.Reports.ReportsWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
                      xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
                      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
                      WindowTransitionsEnabled="False"
                      Background="{DynamicResource MaterialDesignPaper}"					  
                      GlowBrush="{DynamicResource AccentColorBrush}"
                      Icon="/Resources/Logo.ico"
                      Title="ЗВІТИ" 
                      WindowStartupLocation="CenterScreen" 
                      WindowState="Maximized" ResizeMode="CanResize"
                      Closing="MetroWindow_Closing" >

    <materialDesign:DialogHost Identifier="MsgDialog" >
        <dockablz:Layout>
            <DockPanel >
                <dragablz:TabablzControl BorderThickness="2" >
                    <TabItem Header="Аналізи" x:Name="x_AnalyzesTabItem"/>
                    <TabItem Header="Рахунки" x:Name="x_RaxunokTabItem"/>
                </dragablz:TabablzControl>
            </DockPanel>
        </dockablz:Layout>
    </materialDesign:DialogHost>
</controls:MetroWindow>
